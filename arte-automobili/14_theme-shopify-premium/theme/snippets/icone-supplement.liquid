{%- comment -%}
  Icônes de la section « Suppléments de prestation ». Fichier autonome : ajoute phare, patte (poils d'animaux),
  vapeur et ozone sans modifier le snippet « icone » ; toutes les autres icônes sont confiées à « icone ».
  Paramètres : nom, taille (px, 24 par défaut).
{%- endcomment -%}
{%- assign t = taille | default: 24 -%}
{%- case nom -%}
  {%- when 'phare', 'patte', 'vapeur', 'ozone' -%}
    <svg class="icone" viewBox="0 0 24 24" width="{{ t }}" height="{{ t }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
      {%- case nom -%}
        {%- when 'phare' -%}<path d="M3.5 9.5a4 4 0 0 1 4-4H11v11H7.5a4 4 0 0 1-4-4z"/><path d="M14 7.5h7M14 11h7M14 14.5h7" stroke-width="1"/><path d="M2 20.5H22" stroke-width="1"/>
        {%- when 'patte' -%}<circle cx="6.8" cy="9.6" r="1.6"/><circle cx="10.2" cy="6.4" r="1.6"/><circle cx="13.8" cy="6.4" r="1.6"/><circle cx="17.2" cy="9.6" r="1.6"/><path d="M12 11.6c-2.6 0-5 2.9-5 5.1 0 1.4 1 2.1 2.3 2.1 1.1 0 1.7-.5 2.7-.5s1.6.5 2.7.5c1.3 0 2.3-.7 2.3-2.1 0-2.2-2.4-5.1-5-5.1z"/>
        {%- when 'vapeur' -%}<path d="M8 12.5c-1.3-1.5 1.3-2.7 0-4.2s1.3-2.7 0-4.2M12 12.5c-1.3-1.5 1.3-2.7 0-4.2s1.3-2.7 0-4.2M16 12.5c-1.3-1.5 1.3-2.7 0-4.2s1.3-2.7 0-4.2"/><path d="M5 15.5h14v2.5H5z"/><path d="M2 20.5H22" stroke-width="1"/>
        {%- when 'ozone' -%}<path d="M3 8.5h10.5a2.5 2.5 0 1 0-2.5-2.5"/><path d="M3 12.5h15a2.5 2.5 0 1 1-2.5 2.5"/><path d="M3 16.5h6.5"/><path d="M2 20.5H22" stroke-width="1"/>
      {%- endcase -%}
    </svg>
  {%- else -%}
    {%- render 'icone', nom: nom, taille: t -%}
{%- endcase -%}
