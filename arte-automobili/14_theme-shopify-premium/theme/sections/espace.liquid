{%- assign s = section.settings -%}
{% render 'section-style', section: section %}
<div class="s-espace" style="--espace-h: {{ s.hauteur }}px; --espace-h-m: {{ s.hauteur_m }}px;" aria-hidden="true"></div>

{% schema %}
{
  "name": "Espacement",
  "tag": "div",
  "class": "section-bibliotheque",
  "settings": [
    {
      "type": "range",
      "id": "hauteur",
      "label": "Hauteur sur ordinateur",
      "min": 0,
      "max": 240,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "hauteur_m",
      "label": "Hauteur sur mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mise en forme de la section"
    },
    {
      "type": "select",
      "id": "palette",
      "label": "Couleurs de la section",
      "options": [
        {
          "value": "defaut",
          "label": "Fond général du site"
        },
        {
          "value": "nero",
          "label": "Nero (sombre)"
        },
        {
          "value": "verdaccio",
          "label": "Verdaccio (gris profond)"
        },
        {
          "value": "verde",
          "label": "Verde (vert de marque)"
        },
        {
          "value": "bianco",
          "label": "Bianco (clair)"
        },
        {
          "value": "travertino",
          "label": "Travertino (clair chaud)"
        },
        {
          "value": "perso",
          "label": "Personnalisées"
        }
      ],
      "default": "defaut"
    },
    {
      "type": "color",
      "id": "couleur_fond",
      "label": "Fond personnalisé",
      "visible_if": "{{ section.settings.palette == 'perso' }}"
    },
    {
      "type": "color",
      "id": "couleur_texte",
      "label": "Texte personnalisé",
      "visible_if": "{{ section.settings.palette == 'perso' }}"
    },
    {
      "type": "color",
      "id": "couleur_accent",
      "label": "Accent personnalisé",
      "visible_if": "{{ section.settings.palette == 'perso' }}"
    },
    {
      "type": "header",
      "content": "Visibilité"
    },
    {
      "type": "checkbox",
      "id": "afficher_ordinateur",
      "label": "Afficher sur ordinateur et tablette",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "afficher_mobile",
      "label": "Afficher sur mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Espacement"
    }
  ]
}
{% endschema %}
