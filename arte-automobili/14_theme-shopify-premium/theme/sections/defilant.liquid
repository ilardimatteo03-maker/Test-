    },
    {
      "type": "checkbox",
      "id": "bordure_bas",
      "label": "Filet en bas",
      "default": false
    },
    {
      "type": "header",
      "content": "Visibilité"
    },
    {
      "type": "checkbox",
      "id": "afficher_ordinateur",
      "label": "Afficher sur ordinateur et tablette",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "afficher_mobile",
      "label": "Afficher sur mobile",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "texte",
      "name": "Texte",
      "settings": [
        {
          "type": "text",
