{%- assign s = section.settings -%}
{% render 'section-style', section: section %}
<div class="s-liquid{% if s.marges %} section{% endif %}">
  <div class="{% if s.conteneur %}wrap{% endif %}">
    {{ s.code }}
  </div>
</div>

{% schema %}
{
  "name": "Code personnalisé",
  "tag": "div",
  "class": "section-bibliotheque",
  "settings": [
    {
      "type": "paragraph",
      "content": "Réservé aux modifications avancées. Un code incorrect peut casser l'affichage de la page."
    },
    {
      "type": "liquid",
      "id": "code",
      "label": "Code HTML ou Liquid"
    },
    {
      "type": "checkbox",
      "id": "conteneur",
      "label": "Limiter à la largeur du thème",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "marges",
      "label": "Ajouter l'espacement vertical des sections",
      "default": true
    },
    {
      "type": "header",
      "content": "Mise en forme de la section"
    },
    {
      "type": "select",
      "id": "palette",
      "label": "Couleurs de la section",
      "options": [
        {
          "value": "defaut",
          "label": "Fond général du site"
        },
        {
          "value": "nero",
          "label": "Nero (sombre)"
        },
        {
          "value": "verdaccio",
          "label": "Verdaccio (gris profond)"
        },
        {
          "value": "verde",
          "label": "Verde (vert de marque)"
        },
        {
          "value": "bianco",
          "label": "Bianco (clair)"
        },
        {
          "value": "travertino",
          "label": "Travertino (clair chaud)"
        },
        {
          "value": "perso",
          "label": "Personnalisées"
        }
      ],
      "default": "defaut"
    },
    {
      "type": "color",
      "id": "couleur_fond",
      "label": "Fond personnalisé",
      "visible_if": "{{ section.settings.palette == 'perso' }}"
    },
    {
      "type": "color",
      "id": "couleur_texte",
      "label": "Texte personnalisé",
      "visible_if": "{{ section.settings.palette == 'perso' }}"
    },
    {
      "type": "color",
      "id": "couleur_accent",
      "label": "Accent personnalisé",
      "visible_if": "{{ section.settings.palette == 'perso' }}"
    },
    {
      "type": "select",
      "id": "largeur",
      "label": "Largeur du contenu",
      "options": [
        {
          "value": "contenu",
          "label": "Largeur du thème"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "pleine",
          "label": "Pleine largeur"
        },
        {
          "value": "bord",
          "label": "Bord à bord (sans marges)"
        }
      ],
      "default": "contenu"
    },
    {
      "type": "checkbox",
      "id": "bordure_haut",
      "label": "Filet en haut",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bordure_bas",
      "label": "Filet en bas",
      "default": false
    },
    {
      "type": "header",
      "content": "Visibilité"
    },
    {
      "type": "checkbox",
      "id": "afficher_ordinateur",
      "label": "Afficher sur ordinateur et tablette",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "afficher_mobile",
      "label": "Afficher sur mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Code HTML ou Liquid personnalisé"
    }
  ]
}
{% endschema %}
