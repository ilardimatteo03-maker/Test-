          "value": "4 / 5",
          "label": "Portrait 4:5"
        },
        {
          "value": "3 / 4",
          "label": "Portrait 3:4"
        },
        {
          "value": "1 / 1",
          "label": "Carré"
        },
        {
          "value": "4 / 3",
          "label": "Paysage 4:3"
        },
        {
          "value": "3 / 2",
          "label": "Paysage 3:2"
        },
        {
          "value": "16 / 10",
          "label": "Paysage 16:10"
        },
        {
          "value": "16 / 9",
          "label": "Panoramique 16:9"
        }
