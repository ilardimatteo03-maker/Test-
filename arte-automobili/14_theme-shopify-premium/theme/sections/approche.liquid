    },
    {
      "type": "text",
      "id": "bouton_texte",
      "label": "Texte du bouton (facultatif)"
    },
    {
      "type": "url",
      "id": "bouton_lien",
      "label": "Lien du bouton"
    },
    {
      "type": "select",
      "id": "bouton_style",
      "label": "Style du bouton",
      "options": [
        {
          "value": "defaut",
          "label": "Style par défaut du thème"
        },
        {
          "value": "primary",
          "label": "Plein"
        },
        {
          "value": "secondary",
