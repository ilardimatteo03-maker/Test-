          "label": "Bord à bord (sans marges)"
        }
      ],
      "default": "contenu"
    },
    {
      "type": "select",
      "id": "espace_haut",
      "label": "Espacement en haut",
      "options": [
        {
          "value": "defaut",
          "label": "Par défaut"
        },
        {
          "value": "aucun",
          "label": "Aucun"
        },
        {
          "value": "petit",
          "label": "Petit"
        },
        {
          "value": "moyen",
          "label": "Moyen"
        },
        {
          "value": "grand",
          "label": "Grand"
        },
        {
          "value": "tres-grand",
          "label": "Très grand"
        }
      ],
      "default": "defaut"
    },
    {
      "type": "select",
      "id": "espace_bas",
      "label": "Espacement en bas",
      "options": [
        {
          "value": "defaut",
          "label": "Par défaut"
        },
        {
          "value": "aucun",
          "label": "Aucun"
        },
        {
          "value": "petit",
          "label": "Petit"
        },
        {
          "value": "moyen",
          "label": "Moyen"
        },
        {
          "value": "grand",
          "label": "Grand"
        },
        {
          "value": "tres-grand",
          "label": "Très grand"
        }
      ],
      "default": "defaut"
    },
    {
      "type": "select",
      "id": "espace_mobile",
      "label": "Espacements sur mobile",
      "options": [
        {
          "value": "auto",
          "label": "Proportionnels"
        },
        {
          "value": "aucun",
          "label": "Aucun"
        },
        {
          "value": "petit",
          "label": "Petits"
        },
        {
          "value": "moyen",
          "label": "Moyens"
        },
        {
          "value": "grand",
          "label": "Grands"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Visibilité"
    },
    {
      "type": "checkbox",
      "id": "afficher_ordinateur",
      "label": "Afficher sur ordinateur et tablette",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "afficher_mobile",
      "label": "Afficher sur mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Mon espace : réservation"
    }
  ]
}
{% endschema %}
