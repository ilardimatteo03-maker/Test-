      "label": "Texte personnalisé",
      "visible_if": "{{ section.settings.palette == 'perso' }}"
    },
    {
      "type": "color",
      "id": "couleur_accent",
      "label": "Accent personnalisé",
      "visible_if": "{{ section.settings.palette == 'perso' }}"
    },
    {
      "type": "select",
      "id": "largeur",
      "label": "Largeur du contenu",
      "options": [
        {
          "value": "contenu",
          "label": "Largeur du thème"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "pleine",
