{%- assign s = section.settings -%}
{% render 'section-style', section: section %}
<section class="section s-reseaux s-reseaux--{{ s.style }}"{% if s.titre != blank %} aria-labelledby="titre-{{ section.id }}"{% endif %}>
  <div class="wrap">
    {% render 'tete-section', s: s, id: section.id %}
    {%- capture liens -%}{% if s.style == 'icones' %}{% render 'reseaux', icones: true %}{% else %}{% render 'reseaux', avec_nom: true %}{% endif %}{%- endcapture -%}
    {%- if liens != blank -%}
      <p class="s-reseaux__liens" style="--reseau-taille: {{ s.taille }}px;">{{ liens }}</p>
    {%- elsif request.design_mode -%}
      <p class="notice">Ajoutez vos profils dans Réglages du thème › Réseaux sociaux.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Réseaux sociaux",
  "tag": "div",
  "class": "section-bibliotheque",
  "settings": [
    {
      "type": "text",
      "id": "surtitre",
      "label": "Surtitre"
    },
    {
      "type": "inline_richtext",
      "id": "titre",
      "label": "Titre",
      "default": "Suivez-<em>nous</em>."
    },
    {
      "type": "richtext",
      "id": "texte",
      "label": "Texte d'introduction"
    },
    {
      "type": "paragraph",
      "content": "Les liens viennent de Réglages du thème › Réseaux sociaux."
    },
    {
      "type": "select",
      "id": "style",
      "label": "Affichage",
      "options": [
        {
          "value": "icones",
          "label": "Icônes"
        },
        {
          "value": "texte",
          "label": "Icônes et noms"
        }
      ],
      "default": "texte"
    },
    {
      "type": "range",
      "id": "taille",
      "label": "Taille des icônes",
      "min": 18,
      "max": 48,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mise en forme de la section"
    },
    {
      "type": "select",
      "id": "palette",
      "label": "Couleurs de la section",
      "options": [
        {
          "value": "defaut",
          "label": "Fond général du site"
        },
        {
          "value": "nero",
          "label": "Nero (sombre)"
        },
        {
          "value": "verdaccio",
          "label": "Verdaccio (gris profond)"
        },
        {
          "value": "verde",
          "label": "Verde (vert de marque)"
        },
        {
          "value": "bianco",
          "label": "Bianco (clair)"
        },
        {
          "value": "travertino",
          "label": "Travertino (clair chaud)"
        },
        {
          "value": "perso",
          "label": "Personnalisées"
        }
      ],
      "default": "defaut"
    },
    {
      "type": "color",
      "id": "couleur_fond",
      "label": "Fond personnalisé",
      "visible_if": "{{ section.settings.palette == 'perso' }}"
    },
    {
      "type": "color",
      "id": "couleur_texte",
      "label": "Texte personnalisé",
      "visible_if": "{{ section.settings.palette == 'perso' }}"
    },
    {
      "type": "color",
      "id": "couleur_accent",
      "label": "Accent personnalisé",
      "visible_if": "{{ section.settings.palette == 'perso' }}"
    },
    {
      "type": "image_picker",
      "id": "fond_image",
      "label": "Image d'arrière-plan (facultative)"
    },
    {
      "type": "range",
      "id": "fond_voile",
      "label": "Voile sur l'image d'arrière-plan",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 60,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "largeur",
      "label": "Largeur du contenu",
      "options": [
        {
          "value": "contenu",
          "label": "Largeur du thème"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "pleine",
          "label": "Pleine largeur"
        },
        {
          "value": "bord",
          "label": "Bord à bord (sans marges)"
        }
      ],
      "default": "contenu"
    },
    {
      "type": "text_alignment",
      "id": "alignement",
      "label": "Alignement du texte",
      "default": "left"
    },
    {
      "type": "select",
