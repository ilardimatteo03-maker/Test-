        {
          "value": "auto",
          "label": "Comme sur ordinateur"
        },
        {
          "value": "left",
          "label": "À gauche"
        },
        {
          "value": "center",
          "label": "Centré"
        }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "espace_haut",
      "label": "Espacement en haut",
      "options": [
        {
          "value": "defaut",
          "label": "Par défaut"
        },
        {
          "value": "aucun",
          "label": "Aucun"
        },
        {
          "value": "petit",
          "label": "Petit"
        },
        {
          "value": "moyen",
          "label": "Moyen"
        },
        {
          "value": "grand",
          "label": "Grand"
        },
        {
          "value": "tres-grand",
          "label": "Très grand"
        }
      ],
      "default": "defaut"
    },
    {
      "type": "select",
      "id": "espace_bas",
      "label": "Espacement en bas",
      "options": [
        {
          "value": "defaut",
          "label": "Par défaut"
        },
        {
          "value": "aucun",
          "label": "Aucun"
        },
        {
          "value": "petit",
          "label": "Petit"
        },
        {
          "value": "moyen",
          "label": "Moyen"
        },
        {
          "value": "grand",
          "label": "Grand"
        },
        {
          "value": "tres-grand",
          "label": "Très grand"
        }
      ],
      "default": "defaut"
    },
    {
      "type": "select",
      "id": "espace_mobile",
      "label": "Espacements sur mobile",
      "options": [
        {
          "value": "auto",
          "label": "Proportionnels"
        },
        {
          "value": "aucun",
          "label": "Aucun"
        },
        {
          "value": "petit",
          "label": "Petits"
        },
        {
          "value": "moyen",
          "label": "Moyens"
        },
        {
          "value": "grand",
          "label": "Grands"
        }
      ],
      "default": "auto"
    },
    {
      "type": "checkbox",
      "id": "bordure_haut",
      "label": "Filet en haut",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bordure_bas",
      "label": "Filet en bas",
