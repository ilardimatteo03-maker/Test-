        {
          "value": "primary",
          "label": "Plein"
        },
        {
          "value": "secondary",
          "label": "Contour"
        },
        {
          "value": "minimal",
          "label": "Minimaliste"
        },
        {
          "value": "fleche",
          "label": "Texte avec flèche"
        },
        {
          "value": "premium",
