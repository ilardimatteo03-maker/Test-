          "label": "Par défaut"
        },
        {
          "value": "aucun",
          "label": "Aucun"
        },
        {
          "value": "petit",
          "label": "Petit"
        },
        {
          "value": "moyen",
          "label": "Moyen"
        },
        {
          "value": "grand",
          "label": "Grand"
        },
        {
          "value": "tres-grand",
