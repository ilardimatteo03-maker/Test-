      "label": "Espacements sur mobile",
      "options": [
        {
          "value": "auto",
          "label": "Proportionnels"
        },
        {
          "value": "aucun",
          "label": "Aucun"
        },
        {
          "value": "petit",
          "label": "Petits"
        },
        {
          "value": "moyen",
          "label": "Moyens"
        },
        {
          "value": "grand",
          "label": "Grands"
        }
