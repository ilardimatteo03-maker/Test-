{%- comment -%}
  Suppléments de prestation : une carte de suppléments (liste élégante ou grille), regroupés par catégories.
  Les blocs « Catégorie » regroupent les blocs « Supplément » qui les suivent. Filtres facultatifs par catégorie.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign u_contact = pages['contact'].url | default: '/pages/contact'
  assign lien_bouton = s.bouton_lien | default: u_contact
  assign nb_cat = 0
  for block in section.blocks
    if block.type == 'categorie'
      assign nb_cat = nb_cat | plus: 1
    endif
  endfor
  assign filtres = false
  if s.filtres and nb_cat > 1
    assign filtres = true
  endif
  assign balise_nom = 'h3'
  if nb_cat > 0
    assign balise_nom = 'h4'
  endif
-%}
{{ 'supplements.css' | asset_url | stylesheet_tag }}
{%- if filtres %}<script src="{{ 'supplements.js' | asset_url }}" defer></script>{% endif -%}
{% render 'section-style', section: section %}
<section class="section s-supp s-supp--{{ s.disposition }} s-supp--cols-{{ s.colonnes_d }}" style="--supp-cols: {{ s.colonnes_d }};"{% if s.titre != blank %} aria-labelledby="titre-{{ section.id }}"{% endif %}>
  <div class="wrap">
    {% render 'tete-section', s: s, id: section.id %}
    {%- if filtres -%}
      <supplements-filtres class="s-supp__filtres" role="group" aria-label="Filtrer les suppléments par catégorie">
        <button type="button" class="s-supp__filtre" data-filtre="tout" aria-pressed="true">{{ s.libelle_tous | default: 'Tout voir' }}</button>
        {%- assign k = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'categorie' -%}
            {%- assign k = k | plus: 1 -%}
            <button type="button" class="s-supp__filtre" data-filtre="{{ section.id }}-{{ k }}" aria-pressed="false">{{ block.settings.titre }}</button>
          {%- endif -%}
        {%- endfor -%}
      </supplements-filtres>
    {%- endif -%}
    <div class="s-supp__groupes">
      {%- for g in (0..nb_cat) -%}
        {%- liquid
          assign cat = nil
          assign k = 0
          assign nb_items = 0
          for block in section.blocks
            if block.type == 'categorie'
              assign k = k | plus: 1
              if k == g
                assign cat = block
              endif
            elsif k == g
              assign nb_items = nb_items | plus: 1
            endif
          endfor
        -%}
        {%- if g == 0 and nb_items == 0 %}{% continue %}{% endif -%}
        <div class="s-supp__groupe" data-groupe="{{ section.id }}-{{ g }}"{% if cat %} {{ cat.shopify_attributes }}{% endif %}>
          {%- if cat -%}
            <div class="s-supp__cat">
              <h3 class="s-supp__cat-titre">{{ cat.settings.titre }}</h3>
              {%- if cat.settings.texte != blank %}<p class="s-supp__cat-texte">{{ cat.settings.texte }}</p>{% endif -%}
            </div>
          {%- endif -%}
          {%- if nb_items > 0 -%}
            <ul class="s-supp__liste" role="list">
              {%- assign k = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'categorie' -%}
                  {%- assign k = k | plus: 1 -%}
                {%- elsif k == g -%}
                  {%- liquid
                    assign b = block.settings
                    case b.badge
                      when 'populaire'
                        assign badge = 'Le plus demandé'
                      when 'recommande'
                        assign badge = 'Recommandé'
                      when 'nouveau'
                        assign badge = 'Nouveau'
                      when 'exclusif'
                        assign badge = 'Exclusif'
                      else
                        assign badge = ''
                    endcase
                  -%}
                  <li class="s-supp__item reveal{% if b.image != blank and s.disposition == 'cartes' %} s-supp__item--image{% endif %}" {{ block.shopify_attributes }}>
                    {%- if b.image != blank and s.disposition == 'cartes' -%}
                      <div class="s-supp__image">{{ b.image | image_url: width: 900 | image_tag: alt: b.image.alt, loading: 'lazy', widths: '450, 900', sizes: '(min-width: 990px) 33vw, 100vw' }}</div>
                    {%- elsif s.afficher_icones and b.icone != 'aucune' -%}
                      <span class="s-supp__icone" aria-hidden="true">{% render 'icone-supplement', nom: b.icone, taille: 26 %}</span>
                    {%- endif -%}
                    <div class="s-supp__corps">
                      <div class="s-supp__ligne">
                        <{{ balise_nom }} class="s-supp__nom">{{ b.nom }}</{{ balise_nom }}>
                        <span class="s-supp__pointilles" aria-hidden="true"></span>
                        {%- if s.afficher_prix and b.prix != blank %}<span class="s-supp__prix">{{ b.prix }}</span>{% endif -%}
                      </div>
                      {%- if s.afficher_badges and badge != blank %}<span class="s-supp__badge">{{ badge }}</span>{% endif -%}
                      {%- if s.afficher_descriptions and b.description != blank %}<p class="s-supp__desc">{{ b.description }}</p>{% endif -%}
                      {%- if s.afficher_durees and b.duree != blank %}<p class="s-supp__duree">{% render 'icone', nom: 'horaires', taille: 14 %}<span>{{ b.duree }}</span></p>{% endif -%}
                      {%- if b.lien != blank %}<a class="lien s-supp__lien" href="{{ b.lien }}"><span>{{ b.lien_texte | default: 'En savoir plus' }}</span>{% render 'icon-arrow' %}</a>{% endif -%}
                    </div>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if s.mention != blank or s.bouton != blank -%}
      <div class="s-supp__pied">
        {%- if s.mention != blank %}<p class="s-supp__mention">{{ s.mention }}</p>{% endif -%}
        {% render 'bouton', texte: s.bouton, lien: lien_bouton, style: s.bouton_style %}
      </div>
    {%- endif -%}
  </div>
</section>

