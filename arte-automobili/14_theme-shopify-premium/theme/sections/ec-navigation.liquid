          "value": "laterale",
          "label": "Colonne latérale"
        },
        {
          "value": "onglets",
          "label": "Onglets sous l'en-tête"
        }
      ],
      "default": "laterale"
    },
    {
      "type": "range",
      "id": "largeur_laterale",
      "label": "Largeur de la colonne latérale",
      "min": 200,
      "max": 320,
      "step": 4,
      "default": 248,
      "visible_if": "{{ section.settings.style_ordinateur == 'laterale' }}",
      "unit": "px"
    },
    {
      "type": "select",
      "id": "style_mobile",
