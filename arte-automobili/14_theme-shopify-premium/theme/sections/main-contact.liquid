{%- liquid
  assign u_confidentialite = shop.privacy_policy.url | default: '/policies/privacy-policy'
  assign a_coord = false
  if settings.telephone != blank or settings.email != blank or settings.adresse != blank or settings.zone != blank or settings.horaires != blank
    assign a_coord = true
  endif
-%}
<section class="contact wrap" aria-labelledby="contact-titre-{{ section.id }}">
  <div class="contact__intro">
    {%- if section.settings.surtitre != blank %}<p class="label">{{ section.settings.surtitre }}</p>{% endif -%}
    <h1 id="contact-titre-{{ section.id }}">{{ section.settings.titre }}</h1>
    {%- if section.settings.texte != blank %}<p class="contact__texte">{{ section.settings.texte }}</p>{% endif -%}
    {%- if a_coord -%}
      <dl class="coordonnees">
        {%- if settings.telephone != blank %}<div><dt>Téléphone</dt><dd><a href="tel:{{ settings.telephone | remove: ' ' | remove: '.' }}">{{ settings.telephone }}</a></dd></div>{% endif -%}
        {%- if settings.email != blank %}<div><dt>E-mail</dt><dd><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></dd></div>{% endif -%}
        {%- if settings.adresse != blank %}<div><dt>Adresse</dt><dd>{{ settings.adresse }}</dd></div>{% endif -%}
        {%- if settings.zone != blank %}<div><dt>Zone</dt><dd>{{ settings.zone }}</dd></div>{% endif -%}
        {%- if settings.horaires != blank %}<div><dt>Horaires</dt><dd>{{ settings.horaires }}</dd></div>{% endif -%}
      </dl>
    {%- endif -%}
    <p class="reseaux">{% render 'reseaux' %}</p>
  </div>

  <div class="contact__formulaire" id="formulaire">
    {%- comment -%}
      Formulaire de contact natif Shopify : chaque demande est envoyée par Shopify à l'adresse e-mail
      de la boutique. La confirmation n'apparaît qu'après la réponse de Shopify (form.posted_successfully?).
    {%- endcomment -%}
    {%- form 'contact', id: 'contact-form', class: 'form', novalidate: 'novalidate' -%}
      {%- if form.posted_successfully? -%}
        <div class="confirmation" data-confirmation tabindex="-1">
          <p class="label">Demande envoyée</p>
          <h2>{{ section.settings.confirmation_titre }}</h2>
          <p>{{ section.settings.confirmation_texte }}</p>
          <a class="btn btn--secondary" href="{{ routes.root_url }}">Retour à l'accueil</a>
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <p class="notice notice--erreur" role="alert">Votre demande n'a pas pu être envoyée : {{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="form__grille">
          <div class="field">
            <label for="f-nom">Nom et prénom</label>
            <input id="f-nom" name="contact[name]" type="text" autocomplete="name" required data-msg="Indiquez votre nom et votre prénom." value="{{ form.name }}">
            <p class="field__erreur" id="f-nom-erreur" hidden></p>
          </div>
          <div class="field">
            <label for="f-email">Adresse e-mail</label>
            <input id="f-email" name="contact[email]" type="email" autocomplete="email" inputmode="email" required data-msg="Indiquez une adresse e-mail valide, par exemple nom@domaine.fr." value="{{ form.email }}">
            <p class="field__erreur" id="f-email-erreur" hidden></p>
          </div>
          <div class="field">
            <label for="f-tel">Téléphone <span class="facultatif">(facultatif)</span></label>
            <input id="f-tel" name="contact[phone]" type="tel" autocomplete="tel" inputmode="tel" pattern="[0-9+().\s\-]{6,}" data-msg="Ce numéro ne semble pas valide." value="{{ form.phone }}">
            <p class="field__erreur" id="f-tel-erreur" hidden></p>
          </div>
          <div class="field">
            <label for="f-service">Service souhaité</label>
            <select id="f-service" name="contact[Service souhaité]" required data-msg="Choisissez le service souhaité.">
              <option value="" selected disabled>Choisir un service</option>
              {%- for i in (1..4) -%}
                {%- liquid
                  assign k_nom = 'p' | append: i | append: '_nom'
                  assign k_form = 'p' | append: i | append: '_formulaire'
                  assign libelle = settings[k_form] | default: settings[k_nom]
                  case i
                    when 1
                      assign ancre = 'interieur'
                    when 2
                      assign ancre = 'exterieur'
                    when 3
                      assign ancre = 'complet'
                    else
                      assign ancre = 'professionnels'
                  endcase
                -%}
                <option value="{{ libelle | escape }}" data-id="{{ ancre }}">{{ libelle }}</option>
              {%- endfor -%}
            </select>
            <p class="field__erreur" id="f-service-erreur" hidden></p>
          </div>
          <div class="field">
            <label for="f-vehicule">Marque et modèle <span class="facultatif">(facultatif)</span></label>
            <input id="f-vehicule" name="contact[Marque et modèle]" type="text" autocomplete="off">
          </div>
          <div class="field">
            <label for="f-date">Date souhaitée <span class="facultatif">(facultatif)</span></label>
            <input id="f-date" name="contact[Date souhaitée]" type="date" data-msg="Choisissez une date à venir.">
            <p class="field__erreur" id="f-date-erreur" hidden></p>
          </div>
          <div class="field field--large">
            <label for="f-message">Message <span class="facultatif">(facultatif)</span></label>
            <textarea id="f-message" name="contact[body]" rows="5">{{ form.body }}</textarea>
          </div>
          <div class="field field--large field--case">
            <input id="f-accord" name="contact[Consentement]" type="checkbox" value="Oui, politique de confidentialité acceptée" required data-msg="Votre accord est nécessaire pour envoyer la demande.">
            <label for="f-accord">J'accepte que les informations saisies soient utilisées pour répondre à ma demande, conformément à la <a href="{{ u_confidentialite }}">politique de confidentialité</a>.</label>
            <p class="field__erreur" id="f-accord-erreur" hidden></p>
          </div>
        </div>
        <div class="form__pied">
          <div class="form__statut" data-statut role="status" aria-live="polite"></div>
          <button class="btn btn--primary" type="submit" data-envoyer><span data-libelle>Envoyer la demande</span>{% render 'icon-arrow' %}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "paragraph", "content": "Les demandes sont envoyées par Shopify à l'adresse e-mail de la boutique. Coordonnées et réseaux : Réglages du thème." },
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Contact" },
    { "type": "inline_richtext", "id": "titre", "label": "Titre", "default": "Parlons de votre <em>véhicule</em>." },
    { "type": "text", "id": "texte", "label": "Introduction", "default": "Rendez-vous, devis ou simple question : décrivez votre demande, nous vous répondrons." },
    { "type": "text", "id": "confirmation_titre", "label": "Titre de confirmation", "default": "Merci, votre demande est bien partie." },
    { "type": "text", "id": "confirmation_texte", "label": "Texte de confirmation", "default": "Nous l'avons reçue et vous répondrons dans les meilleurs délais." }
  ]
}
{% endschema %}
