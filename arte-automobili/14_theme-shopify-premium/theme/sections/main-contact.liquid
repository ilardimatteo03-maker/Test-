{%- liquid
  assign s = section.settings
  assign u_confidentialite = shop.privacy_policy.url | default: '/policies/privacy-policy'
  assign a_coord = false
  if settings.telephone != blank or settings.email != blank or settings.adresse != blank or settings.zone != blank or settings.horaires != blank
    assign a_coord = true
  endif
  if s.afficher_coordonnees == false
    assign a_coord = false
  endif
  assign sid = section.id
  assign form_id = 'contact-form-' | append: sid
  assign motifs = s.motifs | newline_to_br | split: '<br />'
  assign motifs_net = s.motifs | strip
  assign style_b = s.bouton_style | default: 'primary'
  if style_b == 'defaut'
    assign style_b = settings.btn_style_defaut
  endif
-%}
{% render 'section-style', section: section %}
<section class="contact wrap{% if s.disposition == 'formulaire' %} contact--formulaire-seul{% endif %}" aria-labelledby="contact-titre-{{ sid }}">
  <div class="contact__intro">
    {%- if section.settings.surtitre != blank %}<p class="label">{{ section.settings.surtitre }}</p>{% endif -%}
    <{{ s.balise_titre | default: 'h1' }} class="contact__titre" id="contact-titre-{{ sid }}">{{ section.settings.titre }}</{{ s.balise_titre | default: 'h1' }}>
    {%- if section.settings.texte != blank %}<p class="contact__texte">{{ section.settings.texte }}</p>{% endif -%}
    {%- if a_coord -%}
      <dl class="coordonnees">
        {%- if settings.telephone != blank %}<div><dt>Téléphone</dt><dd><a href="tel:{{ settings.telephone | remove: ' ' | remove: '.' }}">{{ settings.telephone }}</a></dd></div>{% endif -%}
        {%- if settings.email != blank %}<div><dt>E-mail</dt><dd><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></dd></div>{% endif -%}
        {%- if settings.adresse != blank %}<div><dt>Adresse</dt><dd>{{ settings.adresse }}</dd></div>{% endif -%}
        {%- if settings.zone != blank %}<div><dt>Zone</dt><dd>{{ settings.zone }}</dd></div>{% endif -%}
        {%- if settings.horaires != blank and s.afficher_horaires != false %}<div><dt>Horaires</dt><dd>{{ settings.horaires }}</dd></div>{% endif -%}
      </dl>
    {%- endif -%}
    {%- unless s.afficher_reseaux == false %}
    <p class="reseaux">{% render 'reseaux' %}</p>
    {%- endunless %}
  </div>

  <div class="contact__formulaire" id="formulaire">
    {%- comment -%}
      Formulaire de contact natif Shopify : chaque demande est envoyée par Shopify à l'adresse e-mail
      de la boutique. La confirmation n'apparaît qu'après la réponse de Shopify (form.posted_successfully?).
    {%- endcomment -%}
    {%- form 'contact', id: form_id, class: 'form js-formulaire', novalidate: 'novalidate' -%}
      {%- if form.posted_successfully? -%}
        <div class="confirmation" data-confirmation tabindex="-1">
          <p class="label">Demande envoyée</p>
          <h2>{{ section.settings.confirmation_titre }}</h2>
          <p>{{ section.settings.confirmation_texte }}</p>
          <a class="btn btn--secondary" href="{{ routes.root_url }}">Retour à l'accueil</a>
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <p class="notice notice--erreur" role="alert">Votre demande n'a pas pu être envoyée : {{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="form__grille">
          <div class="field">
            <label for="f-nom-{{ sid }}">{{ s.libelle_nom | default: 'Nom et prénom' }}</label>
            <input id="f-nom-{{ sid }}" name="contact[name]" type="text" autocomplete="name" required data-msg="Indiquez votre nom et votre prénom." value="{{ form.name }}">
            <p class="field__erreur" id="f-nom-{{ sid }}-erreur" hidden></p>
          </div>
          <div class="field">
            <label for="f-email-{{ sid }}">{{ s.libelle_email | default: 'Adresse e-mail' }}</label>
            <input id="f-email-{{ sid }}" name="contact[email]" type="email" autocomplete="email" inputmode="email" required data-msg="Indiquez une adresse e-mail valide, par exemple nom@domaine.fr." value="{{ form.email }}">
            <p class="field__erreur" id="f-email-{{ sid }}-erreur" hidden></p>
          </div>
          {%- unless s.afficher_telephone == false %}
          <div class="field">
            <label for="f-tel-{{ sid }}">Téléphone{% unless s.telephone_requis %} <span class="facultatif">(facultatif)</span>{% endunless %}</label>
            <input id="f-tel-{{ sid }}" name="contact[phone]" type="tel" autocomplete="tel" inputmode="tel" pattern="[0-9+().\s\-]{6,}"{% if s.telephone_requis %} required{% endif %} data-msg="{% if s.telephone_requis %}Indiquez un numéro de téléphone valide.{% else %}Ce numéro ne semble pas valide.{% endif %}" value="{{ form.phone }}">
            <p class="field__erreur" id="f-tel-{{ sid }}-erreur" hidden></p>
          </div>
          {%- endunless -%}
          {%- unless s.afficher_service == false %}
          <div class="field">
            <label for="f-service-{{ sid }}">{{ s.libelle_service | default: 'Service souhaité' }}{% unless s.service_requis %} <span class="facultatif">(facultatif)</span>{% endunless %}</label>
            <select id="f-service-{{ sid }}" name="contact[{{ s.libelle_service | default: 'Service souhaité' | escape }}]"{% if s.service_requis %} required{% endif %} data-msg="Choisissez le service souhaité.">
              <option value="" selected{% if s.service_requis %} disabled{% endif %}>{{ s.placeholder_service | default: 'Choisir un service' }}</option>
              {%- if motifs_net != blank -%}
                {%- for m in motifs -%}{%- assign m_net = m | strip -%}{%- if m_net != blank %}<option value="{{ m_net | escape }}">{{ m_net }}</option>{% endif -%}{%- endfor -%}
              {%- else -%}
              {%- for i in (1..4) -%}
                {%- liquid
                  assign k_nom = 'p' | append: i | append: '_nom'
                  assign k_form = 'p' | append: i | append: '_formulaire'
                  assign libelle = settings[k_form] | default: settings[k_nom]
                  case i
                    when 1
                      assign ancre = 'interieur'
                    when 2
                      assign ancre = 'exterieur'
                    when 3
                      assign ancre = 'complet'
                    else
                      assign ancre = 'professionnels'
                  endcase
                -%}
                <option value="{{ libelle | escape }}" data-id="{{ ancre }}">{{ libelle }}</option>
              {%- endfor -%}
              {%- endif -%}
            </select>
            <p class="field__erreur" id="f-service-{{ sid }}-erreur" hidden></p>
          </div>
          {%- endunless -%}
          {%- unless s.afficher_vehicule == false %}
          <div class="field">
            <label for="f-vehicule-{{ sid }}">Marque et modèle <span class="facultatif">(facultatif)</span></label>
            <input id="f-vehicule-{{ sid }}" name="contact[Marque et modèle]" type="text" autocomplete="off">
          </div>
          {%- endunless -%}
          {%- unless s.afficher_date == false %}
          <div class="field">
            <label for="f-date-{{ sid }}">Date souhaitée <span class="facultatif">(facultatif)</span></label>
            <input id="f-date-{{ sid }}" name="contact[Date souhaitée]" type="date" data-msg="Choisissez une date à venir.">
            <p class="field__erreur" id="f-date-{{ sid }}-erreur" hidden></p>
          </div>
          {%- endunless -%}
          {%- unless s.afficher_message == false %}
          <div class="field field--large">
            <label for="f-message-{{ sid }}">Message{% unless s.message_requis %} <span class="facultatif">(facultatif)</span>{% endunless %}</label>
            <textarea id="f-message-{{ sid }}" name="contact[body]" rows="5"{% if s.message_requis %} required data-msg="Écrivez votre message."{% endif %}>{{ form.body }}</textarea>
            {%- if s.message_requis %}<p class="field__erreur" id="f-message-{{ sid }}-erreur" hidden></p>{% endif %}
          </div>
          {%- endunless -%}
          {%- unless s.afficher_consentement == false %}
          <div class="field field--large field--case">
            <input id="f-accord-{{ sid }}" name="contact[Consentement]" type="checkbox" value="Oui, politique de confidentialité acceptée" required data-msg="Votre accord est nécessaire pour envoyer la demande.">
            <label for="f-accord-{{ sid }}">J'accepte que les informations saisies soient utilisées pour répondre à ma demande, conformément à la <a href="{{ u_confidentialite }}">politique de confidentialité</a>.</label>
            <p class="field__erreur" id="f-accord-{{ sid }}-erreur" hidden></p>
          </div>
          {%- endunless %}
        </div>
        <div class="form__pied">
          <div class="form__statut" data-statut role="status" aria-live="polite"></div>
          <button class="btn btn--{{ style_b }}" type="submit" data-envoyer><span data-libelle>{{ s.bouton_texte | default: 'Envoyer la demande' }}</span>{% render 'icon-arrow' %}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

