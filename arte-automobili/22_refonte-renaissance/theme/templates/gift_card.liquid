{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Carte cadeau — {{ shop.name }}</title>
    <style>
      @font-face { font-family: 'Bodoni Moda'; src: url('{{ 'BodoniModa-Italic.woff2' | asset_url }}') format('woff2'); font-style: italic; font-weight: 400 900; }
      @font-face { font-family: 'Archivo'; src: url('{{ 'Archivo.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-stretch: 62% 125%; }
      @font-face { font-family: 'DM Mono'; src: url('{{ 'DMMono-Regular.woff2' | asset_url }}') format('woff2'); }
      :root { --nero: {{ settings.color_nero }}; --bianco: {{ settings.color_bianco }}; --verde: {{ settings.color_verde }}; --verdaccio: {{ settings.color_verdaccio }}; --argento: {{ settings.color_argento }}; }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="section">
      <div class="wrap" style="max-width:760px">
        <div style="background:var(--verde);padding:48px;display:flex;flex-direction:column;gap:24px">
          <p style="margin:0;font:italic 400 48px/1 var(--serif)">Carte cadeau</p>
          <hr class="linea" style="border-color:rgba(238,237,231,.5)">
          <p class="mono" style="margin:0;font-size:13px;letter-spacing:.06em">SOLDE</p>
          <p style="margin:0;font:300 44px/1 var(--mono)">{{ gift_card.balance | money }}</p>
          {%- if gift_card.balance != gift_card.initial_value -%}<p class="mono" style="margin:0;font-size:13px;opacity:.8">VALEUR INITIALE {{ gift_card.initial_value | money }}</p>{%- endif -%}
          <p class="mono" style="margin:0;font-size:22px;letter-spacing:.12em">{{ gift_card.code | format_code }}</p>
          {%- if gift_card.expired or gift_card.enabled == false -%}
            <p class="notice notice--error" style="margin:0">Cette carte n'est plus valable.</p>
          {%- elsif gift_card.expires_on -%}
            <p class="mono" style="margin:0;font-size:13px;opacity:.8">VALABLE JUSQU'AU {{ gift_card.expires_on | date: '%d.%m.%Y' }}</p>
          {%- endif -%}
          <img src="{{ 'logo-principal-bianco.svg' | asset_url }}" alt="{{ shop.name }}" width="140" height="46" style="height:46px;width:auto">
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px">
          <a class="btn btn--primary" href="{{ shop.url }}">Utiliser sur la boutique</a>
          <button class="btn btn--secondary" type="button" onclick="window.print()">Imprimer</button>
        </div>
        <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" style="margin-top:28px;background:#fff;padding:12px;display:inline-block"></div>
        <script>
          window.addEventListener('load', function () {
            var el = document.getElementById('QrCode');
            if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
          });
        </script>
      </div>
    </main>
  </body>
</html>
