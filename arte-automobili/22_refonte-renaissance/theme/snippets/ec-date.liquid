{%- comment -%}
  Date en français. Paramètres : date (texte AAAA-MM-JJ HH:MM, ou date Shopify), format :
  « court » (2 nov. 2026, par défaut), « long » (lundi 2 novembre 2026), « jour » (2 nov.), « heure » (10 h 00).
  Une date illisible est affichée telle quelle.
{%- endcomment -%}
{%- liquid
  assign test = date | date: 'x%Yx' | append: ''
  assign brut = date | append: ''
  if test == brut or date == blank
    echo date
  else
  assign jours = 'dimanche,lundi,mardi,mercredi,jeudi,vendredi,samedi' | split: ','
  assign mois = 'janvier,février,mars,avril,mai,juin,juillet,août,septembre,octobre,novembre,décembre' | split: ','
  assign mois_c = 'janv.,févr.,mars,avr.,mai,juin,juil.,août,sept.,oct.,nov.,déc.' | split: ','
  assign w = date | date: '%w' | plus: 0
  assign m = date | date: '%m' | plus: 0 | minus: 1
  assign j = date | date: '%d' | plus: 0
  assign a = date | date: '%Y'
  assign j_txt = j | append: ''
  if j == 1
    assign j_txt = '1er'
  endif
  case format
    when 'long'
      echo jours[w] | append: ' ' | append: j_txt | append: ' ' | append: mois[m] | append: ' ' | append: a
    when 'jour'
      echo j_txt | append: ' ' | append: mois_c[m]
    when 'heure'
      echo date | date: '%H h %M'
    else
      echo j_txt | append: ' ' | append: mois_c[m] | append: ' ' | append: a
  endcase
  endif
-%}
