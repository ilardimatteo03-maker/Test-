{%- assign s = section.settings -%}
{% render 'section-style', section: section %}
<section class="s-defilant s-defilant--{{ s.taille }}{% if s.inverse %} s-defilant--inverse{% endif %}" style="--defile-duree: {{ s.vitesse }}s; --sec-pt-defaut: {{ s.espacement }}px;" aria-label="{{ s.libelle | default: 'Bandeau défilant' | escape }}">
  <div class="s-defilant__piste">
    {%- for i in (1..2) -%}
      <ul class="s-defilant__groupe"{% if i == 2 %} aria-hidden="true"{% endif %} role="list">
        {%- for block in section.blocks -%}
          <li class="s-defilant__item" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>
            {%- if block.settings.lien != blank %}<a href="{{ block.settings.lien }}"{% if i == 2 %} tabindex="-1"{% endif %}>{{ block.settings.texte }}</a>{% else %}{{ block.settings.texte }}{% endif -%}
            <span class="s-defilant__sep s-defilant__sep--{{ s.separateur }}" aria-hidden="true">
              {%- case s.separateur -%}
                {%- when 'monogramme' %}<img src="{{ 'monogramme-bianco.svg' | asset_url }}" alt="" width="18" height="24" loading="lazy">
                {%- when 'losange' %}◆
                {%- when 'point' %}·
                {%- when 'filet' %}<span></span>
              {%- endcase -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</section>
