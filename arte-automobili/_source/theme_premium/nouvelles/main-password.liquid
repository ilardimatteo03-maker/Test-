{%- liquid
  assign s = section.settings
  assign est_mdp = false
  if template.name == 'password'
    assign est_mdp = true
  endif
  assign variante = 'bianco'
  if s.palette == 'bianco' or s.palette == 'travertino'
    assign variante = 'nero'
  endif
  assign libelles = s.libelles | default: 'jours, heures, minutes, secondes' | split: ','
  assign cinema = false
  if s.mise_en_scene == 'cinema'
    assign cinema = true
  endif
  assign texte = s.texte | default: shop.password_message
  assign a_video = false
  if s.type_fond == 'video'
    if s.video != blank or s.video_url != blank
      assign a_video = true
    endif
  endif
-%}
{% render 'section-style', section: section %}
{%- capture logo -%}
  {%- case s.logo_style -%}
    {%- when 'aucun' -%}
    {%- when 'image' -%}
      {%- if settings.logo != blank %}{{ settings.logo | image_url: width: 600 | image_tag: alt: shop.name, class: 'lancement__logo', style: 'width: var(--lancement-logo)', loading: 'eager' }}{% endif -%}
    {%- when 'monogramme' -%}
      {%- if cinema -%}
        <img class="lancement__logo lancement__logo--monogramme" src="{{ 'monogramme-bianco.svg' | asset_url }}" alt="{{ shop.name }}" width="60" height="80"{% if variante == 'nero' %} style="filter: invert(1)"{% endif %}>
      {%- else -%}
        <img src="{{ 'monogramme-bianco.svg' | asset_url }}" alt="{{ shop.name }}" width="60" height="80" class="mot-de-passe__logo"{% if variante == 'nero' %} style="filter: invert(1)"{% endif %}>
      {%- endif -%}
    {%- when 'principal' -%}
      <img class="lancement__logo" src="{{ 'logo-principal-' | append: variante | append: '.svg' | asset_url }}" alt="{{ shop.name }}" width="479" height="151">
    {%- else -%}
      <img class="lancement__logo" src="{{ 'logo-vertical-' | append: variante | append: '.svg' | asset_url }}" alt="{{ shop.name }}" width="289" height="407">
  {%- endcase -%}
{%- endcapture -%}
{%- capture extras -%}
  {%- if s.date_affichee != blank %}<p class="lancement__date">{% render 'icone', nom: 'rendez-vous', taille: 18 %}<span>{{ s.date_affichee }}</span></p>{% endif -%}
  {%- if s.compte_a_rebours and s.date != blank -%}
    <compte-a-rebours class="lancement__compte" data-date="{{ s.date | escape }}" data-fuseau="{{ s.fuseau }}" data-fin="{{ s.message_fin | escape }}" hidden>
      <span class="lancement__unite"><span class="lancement__nombre" data-jours>00</span><span class="lancement__libelle">{{ libelles[0] | strip }}</span></span>
      <span class="lancement__unite"><span class="lancement__nombre" data-heures>00</span><span class="lancement__libelle">{{ libelles[1] | strip }}</span></span>
      <span class="lancement__unite"><span class="lancement__nombre" data-minutes>00</span><span class="lancement__libelle">{{ libelles[2] | strip }}</span></span>
      <span class="lancement__unite"><span class="lancement__nombre" data-secondes>00</span><span class="lancement__libelle">{{ libelles[3] | strip }}</span></span>
    </compte-a-rebours>
  {%- endif -%}
  {%- if s.liste_attente -%}
    <div class="lancement__inscription">
      {%- if s.invitation != blank %}<p class="lancement__invitation">{{ s.invitation }}</p>{% endif -%}
      {% render 'formulaire-email', id: section.id, bouton: s.bouton, confirmation: s.confirmation, mention: s.mention, tags: s.tags, style_bouton: s.style_bouton %}
    </div>
  {%- endif -%}
  {%- if s.afficher_coordonnees and settings.telephone != blank or s.afficher_coordonnees and settings.email != blank -%}
    <p class="lancement__coordonnees">
      {%- if settings.telephone != blank %}<a href="tel:{{ settings.telephone | remove: ' ' | remove: '.' }}">{{ settings.telephone }}</a>{% endif -%}
      {%- if settings.email != blank %}<a href="mailto:{{ settings.email }}">{{ settings.email }}</a>{% endif -%}
    </p>
  {%- endif -%}
  {%- if s.afficher_reseaux %}<p class="lancement__reseaux">{% render 'reseaux', icones: true %}</p>{% endif -%}
{%- endcapture -%}
{%- assign extras = extras | strip -%}
{%- if cinema -%}
<section class="lancement lancement--{{ s.position }}" style="--voile: {{ s.voile | divided_by: 100.0 }}; --lancement-l: {{ s.largeur_contenu }}px; --lancement-logo: {{ s.logo_largeur }}px;" aria-labelledby="lancement-titre-{{ section.id }}">
  <div class="lancement__fond" aria-hidden="true">
    {%- case s.type_fond -%}
      {%- when 'image' -%}
        {%- if s.image != blank -%}
          {% render 'media', image: s.image, alt: '', sizes: '100vw', eager: true %}
        {%- else -%}
          {%- render 'image-asset', nom: 'accueil-hero', largeurs: '1200,2400', largeur: 2400, hauteur: 1350, sizes: '100vw', alt: '', eager: true -%}
        {%- endif -%}
      {%- when 'video' -%}
        {%- if s.video != blank -%}
          {{ s.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '2400x' }}
        {%- elsif s.video_url != blank -%}
          <iframe class="hero__iframe" src="{% if s.video_url.type == 'youtube' %}https://www.youtube-nocookie.com/embed/{{ s.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ s.video_url.id }}&controls=0&playsinline=1&rel=0{% else %}https://player.vimeo.com/video/{{ s.video_url.id }}?background=1&autoplay=1&loop=1&muted=1{% endif %}" title="Vidéo d'ambiance" allow="autoplay" tabindex="-1"></iframe>
        {%- endif -%}
      {%- when 'degrade' -%}
        <div class="lancement__degrade" style="background: {{ s.degrade }};"></div>
    {%- endcase -%}
    {%- if s.type_fond == 'image' or a_video %}<div class="lancement__voile"></div>{% endif -%}
    {%- if s.lame %}<div class="hero__lame"></div>{% endif -%}
  </div>
  <div class="wrap lancement__corps">
    <div class="lancement__contenu">
      {{ logo }}
      {%- if s.surtitre != blank %}<p class="label lancement__surtitre">{{ s.surtitre }}</p>{% endif -%}
      <h1 class="lancement__titre" id="lancement-titre-{{ section.id }}">{{ s.titre }}</h1>
      {%- if s.afficher_linea %}<hr class="linea lancement__linea">{% endif -%}
      {%- if texte != blank %}<p class="lancement__texte">{{ texte }}</p>{% endif -%}
      {{ extras }}
      {%- if est_mdp and s.acces_mdp -%}
        {%- form 'storefront_password', class: 'lancement__acces' -%}
          <details{% if form.errors %} open{% endif %}>
            <summary>{{ s.libelle_acces }}</summary>
            <div class="lancement__acces-champ">
              <label class="visually-hidden" for="pw-{{ section.id }}">Mot de passe</label>
              <input id="pw-{{ section.id }}" type="password" name="password" autocomplete="off" placeholder="Mot de passe"{% if form.errors %} aria-invalid="true" aria-describedby="pw-erreur-{{ section.id }}"{% endif %}>
              <button class="btn btn--secondary btn--petit" type="submit">Entrer</button>
            </div>
            {%- if form.errors %}<p class="field__erreur" id="pw-erreur-{{ section.id }}" role="alert">Mot de passe incorrect.</p>{% endif -%}
          </details>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- else -%}
{%- comment -%} Mise en scène sobre : balisage de la page mot de passe d'origine, textes réglables. {%- endcomment -%}
<section class="entete entete--seule wrap mot-de-passe" style="--lancement-logo: {{ s.logo_largeur }}px;">
  {{ logo }}
  {%- if s.surtitre != blank %}<p class="label">{{ s.surtitre }}</p>{% endif -%}
  <h1>{{ s.titre }}</h1>
  {%- if s.afficher_linea %}<hr class="linea mot-de-passe__linea">{% endif -%}
  {%- if texte != blank %}<p class="entete__texte">{{ texte }}</p>{% endif -%}
  {%- if extras != blank %}<div class="mot-de-passe__extras">{{ extras }}</div>{% endif -%}
  {%- if est_mdp and s.acces_mdp -%}
    {%- form 'storefront_password', class: 'field mot-de-passe__form' -%}
      <label for="pw">{{ s.libelle_acces | default: 'Accès réservé' }}</label>
      <input id="pw" type="password" name="password" autocomplete="off" placeholder="Mot de passe">
      <button class="btn btn--secondary" type="submit">Entrer</button>
      {%- if form.errors -%}<p class="notice notice--erreur">Mot de passe incorrect.</p>{%- endif -%}
    {%- endform -%}
  {%- endif -%}
</section>
{%- endif -%}
