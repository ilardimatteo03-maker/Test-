<section class="entete entete--seule wrap mot-de-passe">
  <img src="{{ 'monogramme-bianco.svg' | asset_url }}" alt="{{ shop.name }}" width="60" height="80" class="mot-de-passe__logo">
  <p class="label">Bientôt</p>
  <h1>Le site ouvre <em>bientôt</em>.</h1>
  {%- if shop.password_message != blank %}<p class="entete__texte">{{ shop.password_message }}</p>{% endif -%}
  {%- form 'storefront_password', class: 'field mot-de-passe__form' -%}
    <label for="pw">Accès réservé</label>
    <input id="pw" type="password" name="password" autocomplete="off" placeholder="Mot de passe">
    <button class="btn btn--secondary" type="submit">Entrer</button>
    {%- if form.errors -%}<p class="notice notice--erreur">Mot de passe incorrect.</p>{%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{ "name": "Page mot de passe", "settings": [] }
{% endschema %}
