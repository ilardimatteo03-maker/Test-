<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_nero }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    {%- if page_description -%}<meta property="og:description" content="{{ page_description | escape }}">{%- endif -%}
    <meta property="og:url" content="{{ canonical_url }}">
    {%- if settings.image_partage != blank -%}
      <meta property="og:image" content="https:{{ settings.image_partage | image_url: width: 1200 }}">
    {%- else -%}
      <meta property="og:image" content="https:{{ 'partage.jpg' | asset_url }}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">

    {%- comment -%} Polices auto-hébergées : aucun appel à Google Fonts {%- endcomment -%}
    {{ 'BodoniModa.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'Archivo.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face { font-family: 'Bodoni Moda'; src: url('{{ 'BodoniModa.woff2' | asset_url }}') format('woff2'); font-weight: 400 900; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Bodoni Moda'; src: url('{{ 'BodoniModa-Italic.woff2' | asset_url }}') format('woff2'); font-weight: 400 900; font-style: italic; font-display: swap; }
      @font-face { font-family: 'Archivo'; src: url('{{ 'Archivo.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-stretch: 62% 125%; font-display: swap; }
      @font-face { font-family: 'DM Mono'; src: url('{{ 'DMMono-Regular.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'DM Mono'; src: url('{{ 'DMMono-Light.woff2' | asset_url }}') format('woff2'); font-weight: 300; font-display: swap; }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- comment -%} Couleurs des réglages du thème, après la feuille de style pour la remplacer {%- endcomment -%}
    <style>
      :root { --nero: {{ settings.color_nero }}; --bianco: {{ settings.color_bianco }}; --verde: {{ settings.color_verde }}; --verdaccio: {{ settings.color_verdaccio }}; --argento: {{ settings.color_argento }}; }
    </style>
    <script>document.documentElement.classList.add('js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {%- if template.name == 'index' -%}{% render 'donnees-structurees' %}{%- endif -%}
    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip" href="#contenu">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}
    <main id="contenu" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
  </body>
</html>
