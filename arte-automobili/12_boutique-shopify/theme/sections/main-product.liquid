{%- liquid
  assign current = product.selected_or_first_available_variant
  assign featured = current.featured_media | default: product.featured_media
-%}
<section class="section section--tight">
  <div class="wrap">
    <p class="crumbs"><a href="{{ routes.root_url }}">Accueil</a> / {% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a> / {% endif %}{{ product.title }}</p>
    <div class="product">
      <div class="gallery" data-gallery>
        <div class="gallery__main">
          {%- if featured -%}
            {{ featured.preview_image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: featured.alt | default: product.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="gallery__thumbs">
            {%- for media in product.media limit: 10 -%}
              <button type="button" data-gallery-thumb data-src="{{ media.preview_image | image_url: width: 1600 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="Voir l'image {{ forloop.index }}" aria-current="{% if media.id == featured.id %}true{% else %}false{% endif %}">
                {{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="buy">
        {%- if current.sku != blank -%}<span class="buy__ref">RÉF. {{ current.sku }}</span>{%- endif -%}
        <h1 class="h2">{{ product.title }}</h1>
        <p class="buy__price" data-price>{{ current.price | money }}</p>

        {%- form 'product', product, data-product-form: '', data-currency: cart.currency.iso_code -%}
          <input type="hidden" name="id" value="{{ current.id }}">
          <script type="application/json" data-variants>
            [{%- for v in product.variants -%}{"id":{{ v.id }},"price":{{ v.price }},"available":{{ v.available }},"options":{{ v.options | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
          </script>
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="field" data-option style="border:0;margin:0 0 22px;padding:0">
                <legend style="margin-bottom:12px">{{ option.name }}</legend>
                <div class="chips">
                  {%- for value in option.values -%}
                    <input type="radio" id="opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                    <label for="opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">{{ value }}</label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}
          {%- if product.gift_card? -%}
            <p class="muted" style="font-size:15px">La carte est envoyée par e-mail juste après le paiement.</p>
          {%- endif -%}
          <div class="buy__actions">
            <div class="qty" data-qty>
              <button type="button" data-step="-1" aria-label="Retirer un">−</button>
              <label class="visually-hidden" for="qty-{{ section.id }}">Quantité</label>
              <input id="qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
              <button type="button" data-step="1" aria-label="Ajouter un">+</button>
            </div>
            <button class="btn btn--primary" type="submit" name="add" data-add data-label-add="Ajouter au panier" data-label-soldout="Épuisé"{% unless current.available %} disabled{% endunless %}>
              <span>{% if current.available %}Ajouter au panier{% else %}Épuisé{% endif %}</span>
            </button>
          </div>
        {%- endform -%}

        {%- if settings.shipping_note != blank -%}<p class="mono" style="margin:0;font-size:12px;letter-spacing:.06em;color:var(--argento);text-transform:uppercase">{{ settings.shipping_note }}</p>{%- endif -%}

        <div class="rte muted">{{ product.description }}</div>

        <dl class="spec">
          {%- if product.type != blank -%}<div><dt>GAMME</dt><span class="dots"></span><dd>{{ product.type | upcase }}</dd></div>{%- endif -%}
          {%- unless product.has_only_default_variant -%}<div><dt>FORMATS</dt><span class="dots"></span><dd>{{ product.variants | map: 'title' | join: ' · ' | upcase }}</dd></div>{%- endunless -%}
          <div><dt>MARQUE</dt><span class="dots"></span><dd>{{ product.vendor | upcase }}</dd></div>
        </dl>

        {%- for block in section.blocks -%}
          <details class="acc" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.title }}</summary>
            <div class="rte">{{ block.settings.content }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "description": {{ product.description | strip_html | json }},
  {%- if product.featured_media -%}"image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},{%- endif -%}
  "offers": {
    "@type": "Offer",
    "price": {{ current.price | divided_by: 100.0 | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "https://schema.org/{% if current.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ request.origin | append: product.url | json }}
  }
}
</script>

{% schema %}
{
  "name": "Fiche produit",
  "blocks": [{
    "type": "accordion", "name": "Volet dépliable",
    "settings": [
      { "type": "text", "id": "title", "label": "Titre", "default": "Conseils d'utilisation" },
      { "type": "richtext", "id": "content", "label": "Contenu", "default": "<p>Toujours sur surface froide, à l'ombre. Testez sur une zone discrète.</p>" }
    ]
  }]
}
{% endschema %}
