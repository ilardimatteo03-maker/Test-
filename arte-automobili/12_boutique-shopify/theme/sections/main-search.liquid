<section class="section section--tight">
  <div class="wrap">
    <div class="page-head" style="padding-top:0">
      <h1 class="h2">Recherche</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="field" style="max-width:560px;margin-top:24px">
        <label for="q">Que cherchez-vous ?</label>
        <div class="newsletter"><input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Shampoing, microfibre…"><button class="icon-btn" type="submit" aria-label="Rechercher">{% render 'icon-arrow' %}</button></div>
      </form>
    </div>
    {%- if search.performed -%}
      <p class="mono" style="font-size:13px;color:var(--argento)">{{ search.results_count }} RÉSULTAT{% if search.results_count > 1 %}S{% endif %}</p>
      <div class="products" style="--cols:4;margin-top:24px">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'card-product', product: item %}
          {%- else -%}<a class="card" href="{{ item.url }}"><div class="card__row"><h2 class="card__title">{{ item.title }}</h2></div></a>{%- endif -%}
        {%- else -%}<p class="muted">Aucun résultat pour « {{ search.terms }} ».</p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Recherche" }
{% endschema %}
