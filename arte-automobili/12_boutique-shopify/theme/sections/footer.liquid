<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <img src="{{ 'logo-vertical-bianco.svg' | asset_url }}" alt="{{ shop.name }}" width="88" height="120" loading="lazy">
      <p>{{ settings.signature }}</p>
    </div>
    <nav aria-label="{{ section.settings.menu_1.title | escape }}">
      <span class="label">{{ section.settings.menu_1.title }}</span>
      {%- for link in section.settings.menu_1.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    </nav>
    <nav aria-label="{{ section.settings.menu_2.title | escape }}">
      <span class="label">{{ section.settings.menu_2.title }}</span>
      {%- for link in section.settings.menu_2.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    </nav>
    <div>
      <span class="label">L'atelier</span>
      <nav aria-label="Contact">
        {%- if settings.devis_url != blank -%}<a href="{{ settings.devis_url }}">Demander un devis</a>{%- endif -%}
        <span class="mono" style="font-size:14px">{{ settings.telephone }}</span>
        <span class="mono" style="font-size:14px">{{ settings.adresse }}</span>
        {%- if settings.instagram_url != blank -%}<a href="{{ settings.instagram_url }}">Instagram</a>{%- endif -%}
      </nav>
      {%- if section.settings.newsletter -%}
        {%- form 'customer', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="label" for="nl-email" style="display:block;margin:26px 0 0">Lettre de l'atelier</label>
          <div class="newsletter">
            <input id="nl-email" type="email" name="contact[email]" autocomplete="email" placeholder="Votre e-mail" required>
            <button class="icon-btn" type="submit" aria-label="S'inscrire">{% render 'icon-arrow' %}</button>
          </div>
          {%- if form.posted_successfully? -%}<p class="mono" style="font-size:13px">Inscription enregistrée.</p>{%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
  <div class="wrap footer__legal">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>
      {%- for policy in shop.policies -%}<a href="{{ policy.url }}" style="text-decoration:none">{{ policy.title }}</a>{% unless forloop.last %} · {% endunless %}{%- endfor -%}
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "link_list", "id": "menu_1", "label": "Menu 1", "default": "main-menu" },
    { "type": "link_list", "id": "menu_2", "label": "Menu 2", "default": "footer" },
    { "type": "checkbox", "id": "newsletter", "label": "Inscription à la lettre", "default": true }
  ]
}
{% endschema %}
