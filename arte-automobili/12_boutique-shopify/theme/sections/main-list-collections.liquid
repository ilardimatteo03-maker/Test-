<section class="section section--tight">
  <div class="wrap">
    <div class="page-head" style="padding-top:0"><h1 class="h2">Collections</h1></div>
    <div class="products" style="--cols: 3">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a class="card" href="{{ collection.url }}">
            <div class="card__media">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}
              {%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}
            </div>
            <div class="card__row"><h2 class="card__title">{{ collection.title }}</h2><span class="price">{{ collection.products_count }}</span></div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Liste des collections" }
{% endschema %}
