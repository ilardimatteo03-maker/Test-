{%- paginate blog.articles by 9 -%}
<section class="section section--tight">
  <div class="wrap">
    <div class="page-head" style="padding-top:0"><p class="label">Journal de l'atelier</p><h1 class="h2">{{ blog.title }}</h1></div>
    <div class="products" style="--cols:3">
      {%- for article in blog.articles -%}
        <a class="card" href="{{ article.url }}">
          <div class="card__media" style="aspect-ratio:4/3">
            {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}
          </div>
          <div class="card__row"><h2 class="card__title">{{ article.title }}</h2></div>
          <span class="card__meta">{{ article.published_at | date: '%d.%m.%Y' }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog" }
{% endschema %}
