<section class="section" style="min-height:100vh;display:flex;align-items:center">
  <div class="wrap" style="width:100%">
    <img src="{{ 'monogramme-bianco.svg' | asset_url }}" alt="{{ shop.name }}" width="60" height="80" style="height:80px;width:auto;margin-bottom:40px">
    <p class="label">Bientôt</p>
    <h1>La boutique <em>ouvre bientôt.</em></h1>
    {%- if shop.password_message != blank -%}<p class="muted" style="margin:24px 0 0">{{ shop.password_message }}</p>{%- endif -%}
    <hr class="linea" style="margin:48px 0 32px">
    {%- form 'storefront_password', class: 'field' -%}
      <label for="pw">Accès réservé</label>
      <div class="newsletter" style="max-width:420px"><input id="pw" type="password" name="password" autocomplete="off" placeholder="Mot de passe"><button class="icon-btn" type="submit" aria-label="Entrer">{% render 'icon-arrow' %}</button></div>
      {%- if form.errors -%}<p class="notice notice--error">Mot de passe incorrect.</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Page mot de passe" }
{% endschema %}
