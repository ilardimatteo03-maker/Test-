{%- comment -%}
  Mise en page technique, sans habillage, utilisée par templates/index.taxi-config.liquid.
  Le service de réservation (backend) lit cette page (https://boutique/?view=taxi-config)
  pour récupérer la configuration tarifaire publiée (réglages + sections « Tarifs Taxi Pro » du pied de page).
  Aucun visiteur n'y est envoyé ; elle ne contient que des données déjà publiques.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex, nofollow">
    <title>Taxi Pro configuration</title>
    {{ content_for_header }}
  </head>
  <body>
    {{ content_for_layout }}
    {% render 'tp-config-settings' %}
    {% sections 'footer-group' %}
  </body>
</html>
