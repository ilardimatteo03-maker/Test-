<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="format-detection" content="telephone=no">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- liquid
      assign company = settings.company_name | default: shop.name
      assign title_suffix = ''
      if current_tags
        assign tags_joined = current_tags | join: ', '
        assign title_suffix = ' – ' | append: tags_joined
      endif
      if current_page != 1
        assign title_suffix = title_suffix | append: ' – Page ' | append: current_page
      endif
    -%}
    <title>
      {{- page_title -}}{{ title_suffix }}
      {%- unless page_title contains company %} – {{ company }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags', company: company %}
    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}

    {%- if settings.structured_data -%}
      {% render 'structured-data', company: company %}
    {%- endif -%}
  </head>

  {%- liquid
    assign body_classes = 'template-' | append: template.name
    if template.suffix
      assign body_classes = body_classes | append: ' template-' | append: template.name | append: '-' | append: template.suffix
    endif
    assign body_classes = body_classes | append: ' btn-' | append: settings.button_style
    assign body_classes = body_classes | append: ' input-' | append: settings.input_style
    assign body_classes = body_classes | append: ' card-' | append: settings.card_style
    assign body_classes = body_classes | append: ' anim-' | append: settings.animations
    assign body_classes = body_classes | append: ' preset-' | append: settings.style_preset
  -%}
  <body class="{{ body_classes }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%} Configuration tarifaire : réglages globaux + groupe « Configuration Taxi Pro » {%- endcomment -%}
    {% render 'tp-config-settings' %}
    {% sections 'taxi-config' %}
  </body>
</html>
