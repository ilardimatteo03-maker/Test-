      { "type": "text", "id": "tariff_per_min", "label": "Prix par minute de trajet", "default": "0,30" },
      { "type": "text", "id": "tariff_minimum", "label": "Minimum de facturation", "default": "12" },
      { "type": "header", "content": "Arrondi du prix total" },
