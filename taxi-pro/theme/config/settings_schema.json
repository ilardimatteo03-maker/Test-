  {
    "name": "Style et préréglages",
    "settings": [
      {
        "type": "select",
        "id": "style_preset",
        "label": "Préréglage de style",
        "options": [
          { "value": "premium_black", "label": "Premium Black (noir, blanc, doré)" },
          { "value": "corporate", "label": "Corporate (bleu marine, blanc)" },
          { "value": "modern_taxi", "label": "Modern Taxi (jaune, noir, blanc)" },
          { "value": "luxury_chauffeur", "label": "Luxury Chauffeur (noir, beige, gris)" },
          { "value": "minimal", "label": "Minimal (blanc, gris, noir)" }
