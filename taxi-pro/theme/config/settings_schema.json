  {
    "name": "Tarifs",
    "settings": [
      { "type": "paragraph", "content": "Ces valeurs alimentent le calculateur. Les montants acceptent la virgule (2,15) ou le point (2.15). Les véhicules, forfaits, zones et options se règlent dans le groupe « Configuration Taxi Pro », en bas de la liste des sections de chaque page." },
      { "type": "text", "id": "currency", "label": "Devise (code ISO)", "default": "EUR", "info": "EUR, CHF, GBP, USD, CAD, MAD…" },
      { "type": "text", "id": "number_locale", "label": "Format des montants (code régional)", "info": "Ex. : fr-BE, fr-FR, nl-BE, de-LU. Laissez vide pour suivre la langue du visiteur." },
      { "type": "text", "id": "price_suffix", "label": "Mention après les prix", "default": "TVAC", "info": "Ex. : TVAC, TTC, HT." },
      { "type": "text", "id": "vat_rate", "label": "Taux de TVA inclus dans les prix (%)", "default": "6", "info": "Sert à afficher la part de TVA. Belgique : 6 % ; France : 10 % ; Luxembourg : 3 %. Mettez 0 pour ne pas l'afficher." },
      { "type": "header", "content": "Tarif au kilomètre (tarif général)" },
      { "type": "text", "id": "tariff_base", "label": "Prix de prise en charge", "default": "5" },
      { "type": "text", "id": "tariff_per_km", "label": "Prix au kilomètre", "default": "2" },
