          { "value": "0.1", "label": "10 centimes" },
          { "value": "0.5", "label": "50 centimes" },
          { "value": "1", "label": "Euro (unité) entier" }
        ],
        "default": "0.1"
      },
      {
        "type": "select",
        "id": "tariff_rounding_mode",
