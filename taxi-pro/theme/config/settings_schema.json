      { "type": "color", "id": "color_surface", "label": "Fond secondaire (cartes, sections alternées)" },
      { "type": "color", "id": "color_text", "label": "Texte" },
      { "type": "color", "id": "color_muted", "label": "Texte secondaire" },
      { "type": "color", "id": "color_border", "label": "Bordures" },
