      { "type": "text", "id": "price_note", "label": "Mention sous le prix", "default": "Prix calculé selon nos tarifs en vigueur. Péages éventuels et attente non prévue facturés en sus." },
      { "type": "checkbox", "id": "show_price_breakdown", "label": "Afficher le détail du calcul", "default": true }
    ]
