{%- comment -%}
  Palette résolue : préréglage choisi, puis couleurs personnalisées des réglages.
  Paramètre format : 'css' (déclarations --c-*) ou 'json' (objet pour les e-mails du backend).
  Source unique des préréglages Premium Black, Corporate, Modern Taxi, Luxury Chauffeur, Minimal.
{%- endcomment -%}
{%- liquid
  case settings.style_preset
    when 'corporate'
      assign p_bg = '#FFFFFF'
      assign p_surface = '#F1F4F9'
      assign p_text = '#0F1C33'
      assign p_muted = '#55627A'
      assign p_border = '#D9E0EB'
      assign p_accent = '#163A70'
      assign p_accent_text = '#FFFFFF'
      assign p_inverse_bg = '#0F1C33'
      assign p_inverse_text = '#FFFFFF'
    when 'modern_taxi'
      assign p_bg = '#FFFFFF'
      assign p_surface = '#F5F5F1'
      assign p_text = '#111111'
      assign p_muted = '#5C5C57'
      assign p_border = '#E4E4DE'
      assign p_accent = '#FFC400'
      assign p_accent_text = '#111111'
      assign p_inverse_bg = '#111111'
      assign p_inverse_text = '#FFFFFF'
    when 'luxury_chauffeur'
      assign p_bg = '#F4EFE6'
      assign p_surface = '#EAE3D7'
      assign p_text = '#1B1A18'
      assign p_muted = '#5C5852'
      assign p_border = '#D6CDBE'
      assign p_accent = '#1B1A18'
      assign p_accent_text = '#F4EFE6'
      assign p_inverse_bg = '#1B1A18'
      assign p_inverse_text = '#EDE7DC'
    when 'minimal'
      assign p_bg = '#FFFFFF'
      assign p_surface = '#F4F4F4'
      assign p_text = '#111111'
      assign p_muted = '#666666'
      assign p_border = '#E3E3E3'
      assign p_accent = '#111111'
      assign p_accent_text = '#FFFFFF'
      assign p_inverse_bg = '#161616'
      assign p_inverse_text = '#F5F5F5'
    else
      assign p_bg = '#0B0B0C'
      assign p_surface = '#141416'
      assign p_text = '#F3EFE7'
      assign p_muted = '#A39E94'
      assign p_border = '#2B2A28'
      assign p_accent = '#C8A35A'
      assign p_accent_text = '#0B0B0C'
      assign p_inverse_bg = '#F3EFE7'
      assign p_inverse_text = '#121212'
  endcase

  assign c_bg = settings.color_background | default: p_bg
  assign c_surface = settings.color_surface | default: p_surface
  assign c_text = settings.color_text | default: p_text
  assign c_muted = settings.color_muted | default: p_muted
  assign c_border = settings.color_border | default: p_border
  assign c_accent = settings.color_accent | default: p_accent
  assign c_accent_text = settings.color_accent_text | default: p_accent_text
  assign c_inverse_bg = settings.color_inverse_bg | default: p_inverse_bg
  assign c_inverse_text = settings.color_inverse_text | default: p_inverse_text
-%}
{%- if format == 'json' -%}
{"bg":{{ c_bg | append: '' | json }},"surface":{{ c_surface | append: '' | json }},"text":{{ c_text | append: '' | json }},"muted":{{ c_muted | append: '' | json }},"border":{{ c_border | append: '' | json }},"accent":{{ c_accent | append: '' | json }},"accentText":{{ c_accent_text | append: '' | json }},"inverseBg":{{ c_inverse_bg | append: '' | json }},"inverseText":{{ c_inverse_text | append: '' | json }}}
{%- else -%}
{%- liquid
  assign bg_brightness = c_bg | color_brightness
  assign inv_brightness = c_inverse_bg | color_brightness
  assign acc_brightness = c_accent | color_brightness

  comment
    Lisibilité automatique : l'accent n'est utilisé pour les liens et surtitres que s'il contraste
    assez (3:1) avec le fond ; sinon la couleur du texte prend le relais. Idem pour les boutons (1,3:1).
  endcomment
  assign ratio_bg = c_accent | color_contrast: c_bg
  assign ratio_surface = c_accent | color_contrast: c_surface
  assign ratio_inverse = c_accent | color_contrast: c_inverse_bg
  assign ratio_dark = c_accent | color_contrast: '#111111'

  assign link_default = c_accent
  if ratio_bg < 3
    assign link_default = c_text
  endif
  assign link_alt = c_accent
  if ratio_surface < 3
    assign link_alt = c_text
  endif
  assign link_inverse = c_accent
  if ratio_inverse < 3
    assign link_inverse = c_inverse_text
  endif
  assign link_dark = c_accent
  if ratio_dark < 3
    assign link_dark = '#FFFFFF'
  endif

  assign btn_bg = c_accent
  assign btn_fg = c_accent_text
  if ratio_bg < 1.3
    assign btn_bg = c_text
    assign btn_fg = c_bg
  endif
  assign btn_inverse_bg = c_accent
  assign btn_inverse_fg = c_accent_text
  if ratio_inverse < 1.3
    assign btn_inverse_bg = c_inverse_text
    assign btn_inverse_fg = c_inverse_bg
  endif
  assign btn_dark_bg = c_accent
  assign btn_dark_fg = c_accent_text
  if ratio_dark < 1.6
    assign btn_dark_bg = '#FFFFFF'
    assign btn_dark_fg = '#111111'
  endif
-%}
--scheme-default: {% if bg_brightness < 128 %}dark{% else %}light{% endif %}; --scheme-inverse: {% if inv_brightness < 128 %}dark{% else %}light{% endif %}; --scheme-accent: {% if acc_brightness < 128 %}dark{% else %}light{% endif %};
    --c-bg: {{ c_bg }}; --c-surface: {{ c_surface }}; --c-text: {{ c_text }}; --c-muted: {{ c_muted }}; --c-border: {{ c_border }};
    --c-accent: {{ c_accent }}; --c-accent-text: {{ c_accent_text }}; --c-inverse-bg: {{ c_inverse_bg }}; --c-inverse-text: {{ c_inverse_text }};
    --c-link: {{ link_default }}; --c-link-alt: {{ link_alt }}; --c-link-inverse: {{ link_inverse }}; --c-link-dark: {{ link_dark }};
    --c-btn-bg: {{ btn_bg }}; --c-btn-fg: {{ btn_fg }}; --c-btn-inverse-bg: {{ btn_inverse_bg }}; --c-btn-inverse-fg: {{ btn_inverse_fg }};
    --c-btn-dark-bg: {{ btn_dark_bg }}; --c-btn-dark-fg: {{ btn_dark_fg }};
{%- endif -%}
