{%- comment -%} Balises Open Graph et Twitter. Paramètres : company, title, description, url {%- endcomment -%}
{%- liquid
  assign og_title = title | default: page_title | default: company
  assign og_type = 'website'
  assign og_description = description | default: page_description | default: shop.description | default: company
  if request.page_type == 'article'
    assign og_type = 'article'
  endif
  assign og_image = settings.share_image
  if page_image
    assign og_image = page_image
  endif
-%}
<meta property="og:site_name" content="{{ company | escape }}">
<meta property="og:url" content="{{ url | default: canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code }}">
{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
