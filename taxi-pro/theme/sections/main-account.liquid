<section class="section scheme-default" style="--pad-top: 96px; --pad-bottom: 96px;">
  <div class="container container--narrow">
    <h1 class="h2">{{ 'customer.account_title' | t }}</h1>
    <p>{{ customer.first_name }} {{ customer.last_name }} · {{ customer.email }} · <a href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }}</a> · <a href="{{ routes.account_logout_url }}">{{ 'customer.sign_out' | t }}</a></p>
    <h2 class="h3" style="margin-top: 2.5rem">{{ 'customer.orders' | t }}</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size == 0 -%}<p class="text-muted">{{ 'customer.no_orders' | t }}</p>{%- else -%}
        <table class="rate-table"><tbody>
          {%- for order in customer.orders -%}
            <tr><th scope="row"><a href="{{ order.customer_url }}">{{ order.name }}</a><small>{{ order.created_at | time_tag: format: 'date' }} · {{ order.financial_status_label }}</small></th><td>{{ order.total_price | money }}</td></tr>
          {%- endfor -%}
        </tbody></table>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Compte client", "tag": "div", "class": "section-main-account", "settings": [] }
{% endschema %}
