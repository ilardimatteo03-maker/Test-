<section class="section scheme-default" style="--pad-top: 96px; --pad-bottom: 96px;">
  <div class="container" style="max-width: 520px">
    <h1 class="h2">{{ 'customer.reset_title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'form-grid' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label class="field__label" for="ResetPassword">{{ 'customer.new_password' | t }}</label><input class="input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label class="field__label" for="ResetConfirm">{{ 'customer.password' | t }}</label><input class="input" type="password" id="ResetConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="btn" type="submit">{{ 'customer.reset_submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Nouveau mot de passe", "tag": "div", "class": "section-main-reset", "settings": [] }
{% endschema %}
