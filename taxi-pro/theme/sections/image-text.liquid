{%- comment -%} Image et texte (présentation, histoire, engagements). {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="container">
    <div class="media-text{% if s.image_position == 'right' %} media-text--reverse{% endif %}">
      <div class="media-text__media reveal" style="--ratio: {{ s.ratio }}">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: s.image.alt | default: s.heading }}
        {%- else -%}
          <div class="media-placeholder">{% render 'icon', name: 'car' %}</div>
        {%- endif -%}
      </div>
      <div class="media-text__content reveal" style="--i: 1">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte" style="color: var(--muted)">{{ s.text }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="check-list" style="margin: 1.6rem 0">
            {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %}<span>{{ block.settings.text }}</span></li>{%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if s.button_label != blank -%}<div class="btn-row" style="margin-top: 1.6rem"><a class="btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a></div>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image et texte",
  "tag": "div",
  "class": "section-image-text",
  "max_blocks": 10,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Position de l'image", "options": [ { "value": "left", "label": "Gauche" }, { "value": "right", "label": "Droite" } ], "default": "left" },
    { "type": "select", "id": "ratio", "label": "Format de l'image", "options": [ { "value": "4 / 5", "label": "Portrait" }, { "value": "1 / 1", "label": "Carré" }, { "value": "4 / 3", "label": "Paysage" } ], "default": "4 / 5" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Notre histoire" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une entreprise familiale au service de vos trajets" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Présentez ici votre entreprise : son histoire, ses valeurs, ce qui fait la différence pour vos clients.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "select", "id": "color_scheme", "label": "Couleurs", "options": [ { "value": "default", "label": "Principal" }, { "value": "alt", "label": "Secondaire" }, { "value": "inverse", "label": "Contrasté" } ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "point", "name": "Point fort", "settings": [ { "type": "text", "id": "text", "label": "Texte", "default": "Chauffeurs professionnels et licenciés" } ] }
  ],
  "presets": [ { "name": "Image et texte" } ]
}
{% endschema %}
