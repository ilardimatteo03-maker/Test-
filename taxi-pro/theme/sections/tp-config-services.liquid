{%- comment -%}
  Tarifs Taxi Pro (groupe « Pied de page ») — Prestations réservables.
  Liste proposée dans le formulaire (« Type de prestation ») et mode de calcul de chacune.
  Section invisible pour les visiteurs : elle publie un JSON lu par le calculateur et par le backend.
{%- endcomment -%}
<script type="application/json" data-tp-config="services">
[
{%- for block in section.blocks -%}
  {%- assign img = '' -%}
  {%- if block.settings.image != blank -%}{%- assign img = block.settings.image | image_url: width: 600 | prepend: 'https:' -%}{%- endif -%}
  {
    "id": {{ block.settings.code | default: block.settings.name | handleize | json }},
    "enabled": {{ block.settings.enabled | json }},
    "name": {{ block.settings.name | json }},
    "description": {{ block.settings.description | json }},
    "icon": {{ block.settings.icon | json }},
    "image": {{ img | json }},
    "mode": {{ block.settings.mode | json }},
    "multiplier": {{ block.settings.multiplier | json }},
    "surcharge": {{ block.settings.surcharge | json }},
    "minimum": {{ block.settings.minimum | json }},
    "fixedPrice": {{ block.settings.fixed_price | json }},
    "hourlyRate": {{ block.settings.hourly_rate | json }},
    "minHours": {{ block.settings.min_hours | json }},
    "airport": {{ block.settings.airport | json }},
    "roundTrip": {{ block.settings.round_trip | json }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
</script>
{%- if request.design_mode -%}
  <div class="tp-config-panel" {{ section.shopify_attributes }}>
    <strong>Tarifs Taxi Pro · Prestations</strong> : {{ section.blocks.size }} prestation(s).
    Section invisible pour les visiteurs (bandeau visible uniquement dans l'éditeur).
    {%- if section.blocks.size == 0 %} <span class="tp-warn">Ajoutez au moins une prestation.</span>{% endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Prestations (tarifs)",
  "tag": "div",
  "class": "tp-config",
  "max_blocks": 20,
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "paragraph", "content": "Prestations proposées dans le formulaire de réservation. L'ordre des blocs est l'ordre d'affichage ; la première est sélectionnée par défaut." }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Prestation",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Proposer cette prestation", "default": true },
        { "type": "text", "id": "name", "label": "Nom", "default": "Taxi classique" },
        { "type": "text", "id": "code", "label": "Code", "info": "Identifiant court sans espace (ex. aeroport). Sert aux liens « réserver ce service » et aux restrictions des options et forfaits." },
        { "type": "textarea", "id": "description", "label": "Description courte" },
        {
          "type": "select", "id": "icon", "label": "Icône",
          "options": [
            { "value": "car", "label": "Voiture" }, { "value": "plane", "label": "Avion" }, { "value": "briefcase", "label": "Mallette" },
            { "value": "route", "label": "Itinéraire" }, { "value": "party", "label": "Événement" }, { "value": "clock", "label": "Horloge" },
            { "value": "shield", "label": "Bouclier" }, { "value": "train", "label": "Train" }, { "value": "ring", "label": "Mariage" },
            { "value": "van", "label": "Van" }, { "value": "wheelchair", "label": "Accessibilité" }, { "value": "star", "label": "Étoile" }
          ],
          "default": "car"
        },
        { "type": "image_picker", "id": "image", "label": "Image (facultative)" },
        { "type": "header", "content": "Calcul du prix" },
        {
          "type": "select", "id": "mode", "label": "Mode de calcul",
          "options": [
            { "value": "meter", "label": "Distance (tarif kilométrique, forfaits et zones)" },
            { "value": "hourly", "label": "Mise à disposition (à l'heure)" },
            { "value": "fixed", "label": "Prix fixe" },
            { "value": "quote", "label": "Sur devis (pas de prix affiché)" }
          ],
          "default": "meter"
        },
        { "type": "text", "id": "multiplier", "label": "Coefficient", "default": "1", "info": "Ex. 1,2 = +20 % sur la course. Ne s'applique pas au prix fixe." },
        { "type": "text", "id": "surcharge", "label": "Supplément fixe par trajet" },
        { "type": "text", "id": "minimum", "label": "Minimum propre à la prestation" },
        { "type": "text", "id": "fixed_price", "label": "Prix fixe (mode « Prix fixe »)" },
        { "type": "text", "id": "hourly_rate", "label": "Tarif horaire (mode « à l'heure »)", "info": "Vide : tarif du véhicule, sinon tarif horaire général." },
        { "type": "text", "id": "min_hours", "label": "Durée minimale en heures (mode « à l'heure »)" },
        { "type": "header", "content": "Formulaire" },
        { "type": "checkbox", "id": "airport", "label": "Prestation aéroport (affiche le numéro de vol)", "default": false },
        { "type": "checkbox", "id": "round_trip", "label": "Aller-retour possible", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prestations (tarifs)",
      "blocks": [
        { "type": "service", "settings": { "name": "Taxi classique", "code": "taxi", "icon": "car" } },
        { "type": "service", "settings": { "name": "Transfert aéroport", "code": "aeroport", "icon": "plane", "airport": true } }
      ]
    }
  ]
}
{% endschema %}
