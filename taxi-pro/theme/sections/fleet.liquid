{%- capture booking_url -%}{% render 'page-url', key: 'booking' %}{%- endcapture -%}
{%- comment -%}
  Nos véhicules : vitrine (cartes) ou présentation détaillée avec galerie, capacités et équipements.
  Le « code véhicule » relie la vitrine au véhicule réservable (Pied de page › Véhicules (tarifs))
  pour le présélectionner dans le module de réservation.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign booking_url = booking_url | strip
  if booking_url contains '?'
    assign booking_sep = booking_url | append: '&'
  else
    assign booking_sep = booking_url | append: '?'
  endif
  capture section_link
    render 'page-url', key: 'vehicles'
  endcapture
  assign section_link = s.link_url | default: section_link
-%}
<section class="section scheme-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="container">
    {% render 'section-head', eyebrow: s.eyebrow, heading: s.heading, text: s.text, align: s.align, link_label: s.link_label, link_url: section_link %}

    {%- if s.layout == 'detailed' -%}
      <div class="stack" style="--stack: clamp(3rem, 2rem + 4vw, 6rem)">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- assign code = b.code | handleize -%}
          <article class="media-text{% cycle '', ' media-text--reverse' %}" id="vehicule-{{ code | default: block.id }}" {{ block.shopify_attributes }}>
            <div class="reveal">
              <div class="media-text__media" style="--ratio: 16 / 10">
                {%- if b.image != blank -%}
                  {{ b.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: b.image.alt | default: b.name }}
                {%- else -%}
                  <div class="media-placeholder">{% render 'icon', name: 'car' %}</div>
                {%- endif -%}
              </div>
              {%- if b.gallery_1 != blank or b.gallery_2 != blank or b.gallery_3 != blank -%}
                <div class="grid" style="--cols: 3; --cols-tablet: 3; --cols-mobile: 3; --grid-gap: .6rem; margin-top: .6rem;">
                  {%- for i in (1..3) -%}
                    {%- assign gkey = 'gallery_' | append: i -%}
                    {%- if b[gkey] != blank -%}
                      <div class="media-text__media" style="--ratio: 4 / 3">{{ b[gkey] | image_url: width: 500 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 16vw, 33vw', widths: '250, 400, 500', alt: b[gkey].alt | default: b.name }}</div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
            <div class="media-text__content reveal" style="--i: 1">
              {%- if b.badge != blank -%}<span class="badge">{{ b.badge }}</span>{%- endif -%}
              <h3 class="h2" style="margin-top: .8rem">{{ b.name }}</h3>
              {%- if b.models != blank -%}<p class="text-muted">{{ b.models }}</p>{%- endif -%}
              <ul class="specs" style="margin: 1rem 0 1.4rem; font-size: 1rem;">
                <li>{% render 'icon', name: 'users' %}{{ 'general.passengers' | t: count: b.passengers }}</li>
                <li>{% render 'icon', name: 'luggage' %}{{ 'general.luggage' | t: count: b.luggage }}</li>
              </ul>
              {%- if b.text != blank -%}<div class="rte">{{ b.text }}</div>{%- endif -%}
              {%- if b.equipment != blank -%}
                <ul class="check-list" style="margin: 1.4rem 0; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));">
                  {%- assign lines = b.equipment | newline_to_br | split: '<br />' -%}
                  {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ l }}</span></li>{%- endif -%}{%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if b.price_text != blank -%}<p class="h4" style="color: var(--link)">{{ b.price_text }}</p>{%- endif -%}
              {%- if s.show_book -%}
                <a class="btn" href="{% if code != blank %}{{ booking_sep }}tp_vehicle={{ code }}{% else %}{{ booking_url }}{% endif %}">{{ s.book_label }}{% render 'icon', name: 'arrow-right' %}</a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="grid" style="--cols: {{ s.columns }}; --cols-tablet: 2;">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- assign code = b.code | handleize -%}
          <article class="card card--hover reveal" style="--i: {{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
            <div class="card__media" style="--ratio: 16 / 10">
              {%- if b.badge != blank -%}<span class="badge">{{ b.badge }}</span>{%- endif -%}
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', widths: '400, 600, 900', alt: b.image.alt | default: b.name }}
              {%- else -%}
                <div class="media-placeholder">{% render 'icon', name: 'car' %}</div>
              {%- endif -%}
            </div>
            <div class="card__body">
              <h3 class="card__title h4">{{ b.name }}</h3>
              {%- if b.models != blank -%}<p class="card__text" style="font-size: .9rem">{{ b.models }}</p>{%- endif -%}
              <ul class="specs">
                <li>{% render 'icon', name: 'users' %}{{ 'general.passengers' | t: count: b.passengers }}</li>
                <li>{% render 'icon', name: 'luggage' %}{{ 'general.luggage' | t: count: b.luggage }}</li>
              </ul>
              {%- if b.text != blank -%}<div class="card__text rte">{{ b.text | strip_html | truncatewords: 22 }}</div>{%- endif -%}
              <div class="card__footer">
                {%- if b.price_text != blank -%}<p style="margin: 0 0 .6rem; font-weight: var(--font-body-weight-medium); color: var(--link)">{{ b.price_text }}</p>{%- endif -%}
                {%- if s.show_book -%}
                  <a class="link-arrow" href="{% if code != blank %}{{ booking_sep }}tp_vehicle={{ code }}{% else %}{{ booking_url }}{% endif %}">{{ s.book_label }}{% render 'icon', name: 'arrow-right' %}<span class="visually-hidden"> : {{ b.name }}</span></a>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Véhicules (vitrine)",
  "tag": "div",
  "class": "section-fleet",
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "Vitrine de vos véhicules. Les prix et capacités utilisés pour la réservation se règlent dans « Pied de page › Véhicules (tarifs) »." },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "select", "id": "align", "label": "Alignement du titre", "options": [ { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centré" } ], "default": "left" },
    { "type": "text", "id": "link_label", "label": "Lien de l'en-tête", "default": "Voir la flotte" },
    { "type": "url", "id": "link_url", "label": "Destination du lien", "info": "Vide : page Véhicules." },
    { "type": "select", "id": "layout", "label": "Mise en page", "options": [ { "value": "cards", "label": "Cartes" }, { "value": "detailed", "label": "Détaillée avec galerie" } ], "default": "cards" },
    { "type": "select", "id": "columns", "label": "Colonnes (cartes, ordinateur)", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "3" },
    { "type": "checkbox", "id": "show_book", "label": "Bouton de réservation", "default": true },
    { "type": "text", "id": "book_label", "label": "Texte du bouton", "default": "Réserver ce véhicule" },
    { "type": "select", "id": "color_scheme", "label": "Couleurs", "options": [ { "value": "default", "label": "Principal" }, { "value": "alt", "label": "Secondaire" }, { "value": "inverse", "label": "Contrasté" } ], "default": "alt" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "vehicle",
      "name": "Véhicule",
      "settings": [
        { "type": "text", "id": "name", "label": "Nom", "default": "Berline" },
        { "type": "text", "id": "code", "label": "Code véhicule (réservation)", "info": "Code du véhicule dans « Pied de page › Véhicules (tarifs) » pour le présélectionner." },
        { "type": "text", "id": "models", "label": "Modèles", "info": "Ex. : Mercedes Classe E ou similaire." },
        { "type": "image_picker", "id": "image", "label": "Photo principale" },
        { "type": "image_picker", "id": "gallery_1", "label": "Galerie : photo 1" },
        { "type": "image_picker", "id": "gallery_2", "label": "Galerie : photo 2" },
        { "type": "image_picker", "id": "gallery_3", "label": "Galerie : photo 3" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "number", "id": "passengers", "label": "Passagers", "default": 4 },
        { "type": "number", "id": "luggage", "label": "Bagages", "default": 3 },
        { "type": "richtext", "id": "text", "label": "Description" },
        { "type": "textarea", "id": "equipment", "label": "Équipements", "info": "Un par ligne." },
        { "type": "text", "id": "price_text", "label": "Mention de prix", "info": "Ex. : Aéroport dès 45 €. Laissez vide pour ne rien afficher." }
      ]
    }
  ],
  "presets": [{"name": "Véhicules (vitrine)", "blocks": [{"type": "vehicle", "settings": {"name": "Berline", "code": "berline", "models": "Toyota Camry hybride ou similaire", "passengers": 4, "luggage": 3, "badge": "Le plus demandé", "text": "<p>Confortable et discrète, idéale en ville et vers l'aéroport.</p>", "equipment": "Climatisation\nChargeurs USB\nEau offerte"}}, {"type": "vehicle", "settings": {"name": "Van 8 places", "code": "van", "models": "Mercedes Classe V ou similaire", "passengers": 8, "luggage": 8, "text": "<p>Pour les familles et les groupes, avec de la place pour tous les bagages.</p>", "equipment": "Climatisation\nWi-Fi\nPortes coulissantes"}}, {"type": "vehicle", "settings": {"name": "Classe affaires", "code": "affaires", "models": "Mercedes Classe E ou similaire", "passengers": 3, "luggage": 3, "badge": "Premium", "text": "<p>Berline premium, chauffeur en tenue, presse et Wi-Fi à bord.</p>", "equipment": "Wi-Fi\nSièges cuir\nPresse du jour"}}], "settings": {"heading": "Des véhicules récents et entretenus", "eyebrow": "Notre flotte"}}]
}
{% endschema %}
