{%- comment -%}
  Contact : coordonnées, horaires, réseaux et formulaire natif Shopify (message envoyé à l'e-mail de la boutique).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign phone_href = settings.company_phone | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')' | remove: '/'
  assign wa = settings.company_whatsapp | remove: '+' | remove: ' '
-%}
<section class="section scheme-{{ s.color_scheme }}" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="container">
    {% render 'section-head', eyebrow: s.eyebrow, heading: s.heading, text: s.text %}
    <div class="contact-layout">
      <div class="contact-card reveal">
        <div class="contact-lines" style="font-size: 1.05rem">
          {%- if settings.company_phone != blank -%}<a href="tel:{{ phone_href }}">{% render 'icon', name: 'phone' %}<span><strong>{{ settings.company_phone }}</strong><br><span class="text-muted" style="font-size: .85rem">{{ 'general.phone' | t }}</span></span></a>{%- endif -%}
          {%- if wa != blank -%}<a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}<span>{{ 'general.whatsapp' | t }}</span></a>{%- endif -%}
          {%- if settings.company_email != blank -%}<a href="mailto:{{ settings.company_email }}">{% render 'icon', name: 'mail' %}<span>{{ settings.company_email }}</span></a>{%- endif -%}
          {%- if settings.company_street != blank -%}
            {%- capture addr -%}{{ settings.company_street }}, {{ settings.company_postcode }} {{ settings.company_city }}, {{ settings.company_country }}{%- endcapture -%}
            <a href="https://www.google.com/maps/search/?api=1&query={{ addr | url_encode }}" target="_blank" rel="noopener">{% render 'icon', name: 'pin' %}<span>{{ settings.company_street }}<br>{{ settings.company_postcode }} {{ settings.company_city }}</span></a>
          {%- endif -%}
        </div>
        {%- if s.show_hours -%}
          <h3 class="h5" style="margin: 2rem 0 .6rem; font-family: var(--font-body); text-transform: uppercase; letter-spacing: .12em; font-size: .78rem; color: var(--muted)">{{ 'general.hours' | t }}</h3>
          {% render 'hours-table' %}
        {%- endif -%}
        {%- if s.show_social -%}<div style="margin-top: 2rem">{% render 'social-links' %}</div>{%- endif -%}
      </div>

      <div class="reveal" style="--i: 1">
        {%- if s.form_heading != blank -%}<h3 class="h3">{{ s.form_heading }}</h3>{%- endif -%}
        {%- form 'contact', id: 'ContactForm', class: 'form-grid form-grid--2' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success span-2" role="status" tabindex="-1">{% render 'icon', name: 'check' %} {{ 'contact.success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="form-status form-status--error span-2" role="alert">{{ 'contact.error' | t }} {{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="field">
            <label class="field__label" for="ContactForm-name">{{ 'contact.name' | t }}</label>
            <input class="input" id="ContactForm-name" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
          </div>
          <div class="field">
            <label class="field__label" for="ContactForm-email">{{ 'contact.email' | t }}</label>
            <input class="input" id="ContactForm-email" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
          </div>
          <div class="field span-2">
            <label class="field__label" for="ContactForm-phone">{{ 'contact.phone' | t }}</label>
            <input class="input" id="ContactForm-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
          </div>
          {%- if s.subjects != blank -%}
            <div class="field span-2">
              <label class="field__label" for="ContactForm-subject">{{ 'contact.subject' | t }}</label>
              <select class="select" id="ContactForm-subject" name="contact[subject]">
                {%- assign subjects = s.subjects | split: ',' -%}
                {%- for subj in subjects -%}<option>{{ subj | strip }}</option>{%- endfor -%}
              </select>
            </div>
          {%- endif -%}
          <div class="field span-2">
            <label class="field__label" for="ContactForm-body">{{ 'contact.message' | t }}</label>
            <textarea class="textarea" id="ContactForm-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>
          {%- if settings.privacy_page != blank -%}
            <p class="text-muted span-2" style="font-size: .85rem; margin: 0">{{ 'contact.consent_html' | t: url: settings.privacy_page.url }}</p>
          {%- endif -%}
          <div class="span-2"><button type="submit" class="btn btn--large">{{ 'contact.send' | t }}</button></div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "tag": "div",
  "class": "section-contact",
  "settings": [
    { "type": "paragraph", "content": "Coordonnées et horaires : Paramètres du thème › Identité et Réservation. Les messages arrivent à l'adresse e-mail de la boutique (Paramètres › Notifications)." },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Parlons de votre trajet" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une question, un devis, une réservation de groupe ? Écrivez-nous ou appelez-nous, à toute heure.</p>" },
    { "type": "text", "id": "form_heading", "label": "Titre du formulaire", "default": "Envoyez-nous un message" },
    { "type": "text", "id": "subjects", "label": "Sujets proposés", "default": "Demande de devis, Réservation de groupe, Compte entreprise, Objet oublié, Autre", "info": "Séparés par des virgules. Vide = pas de liste." },
    { "type": "checkbox", "id": "show_hours", "label": "Afficher les horaires", "default": true },
    { "type": "checkbox", "id": "show_social", "label": "Afficher les réseaux sociaux", "default": true },
    { "type": "select", "id": "color_scheme", "label": "Couleurs", "options": [ { "value": "default", "label": "Principal" }, { "value": "alt", "label": "Secondaire" }, { "value": "inverse", "label": "Contrasté" } ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{"name": "Contact", "settings": {"eyebrow": "Contact"}}]
}
{% endschema %}
