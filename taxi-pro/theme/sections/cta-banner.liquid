{%- comment -%} Bannière d'appel à l'action : réserver ou appeler. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign phone_href = settings.company_phone | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')' | remove: '/'
-%}
<section class="section" style="--pad-top: {{ s.padding_top }}px; --pad-bottom: {{ s.padding_bottom }}px;">
  <div class="container">
    <div class="cta-banner cta-banner--split scheme-{{ s.color_scheme }} reveal">
      {%- if s.image != blank -%}<div class="cta-banner__media">{{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1800', alt: '' }}</div>{%- endif -%}
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<div class="rte" style="color: var(--muted)">{{ s.text }}</div>{%- endif -%}
      </div>
      <div class="btn-row">
        {%- if s.button_label != blank -%}<a class="btn btn--large" href="{{ s.button_link | default: settings.booking_page.url | default: '#reservation' }}">{{ s.button_label }}</a>{%- endif -%}
        {%- if s.show_phone and settings.company_phone != blank -%}<a class="btn btn--large btn--secondary" href="tel:{{ phone_href }}">{% render 'icon', name: 'phone' %}{{ settings.company_phone }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Appel à l'action",
  "tag": "div",
  "class": "section-cta",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Besoin d'un taxi maintenant ?" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Réservez en ligne en deux minutes ou appelez-nous directement.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Réserver en ligne" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "checkbox", "id": "show_phone", "label": "Bouton d'appel", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image de fond" },
    { "type": "select", "id": "color_scheme", "label": "Couleurs", "options": [ { "value": "alt", "label": "Secondaire" }, { "value": "inverse", "label": "Contrasté" }, { "value": "accent", "label": "Accent" } ], "default": "accent" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{"name": "Appel à l'action", "settings": {"eyebrow": "24 h/24, 7 j/7"}}]
}
{% endschema %}
