{%- comment -%}
  Héros : grande image ou vidéo, titre, sous-titre, boutons, arguments et calculateur rapide.
  Le calculateur rapide estime le prix réel (itinéraire + tarifs) puis ouvre la page de réservation
  préremplie, ou le module de réservation présent sur la même page.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign uid = 'tpq-' | append: section.id
  assign phone_href = settings.company_phone | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')' | remove: '/'
  assign l_pickup = 'taxi.booking.pickup_label' | t
  assign p_pickup = 'taxi.booking.pickup_placeholder' | t
  assign l_dropoff = 'taxi.booking.dropoff_label' | t
  assign p_dropoff = 'taxi.booking.dropoff_placeholder' | t
  assign l_passengers = 'taxi.booking.passengers_label' | t
  case s.height
    when 'small'
      assign hero_height = '62vh'
    when 'medium'
      assign hero_height = '78vh'
    when 'full'
      assign hero_height = '100svh'
    when 'auto'
      assign hero_height = '0px'
    else
      assign hero_height = '90vh'
  endcase
  assign has_media = false
  if s.image != blank or s.video != blank
    assign has_media = true
  endif
-%}
{%- if s.show_widget -%}
  {{ 'tp-booking.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'tp-pricing.js' | asset_url }}" defer></script>
  <script src="{{ 'tp-geo.js' | asset_url }}" defer></script>
  <script src="{{ 'tp-booking.js' | asset_url }}" defer></script>
{%- endif -%}

<section
  class="hero{% unless has_media %} hero--plain scheme-{{ s.color_scheme }}{% endunless %}{% if s.height == 'auto' %} hero--auto{% endif %}"
  style="--hero-height: {{ hero_height }}; --overlay: {{ s.overlay | divided_by: 100.0 }}; --hero-align-y: {{ s.align_y }}; --hero-gradient-dir: {% if s.align == 'center' %}0deg{% else %}100deg{% endif %};"
>
  {%- if has_media -%}
    <div class="hero__media hero__media--desktop{% if s.image_mobile != blank %} hero__media--has-mobile{% endif %}">
      {%- if s.video != blank -%}
        {{ s.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1920x' }}
      {%- else -%}
        {{ s.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400', alt: s.image.alt | default: s.heading }}
      {%- endif -%}
    </div>
    {%- if s.image_mobile != blank -%}
      <div class="hero__media hero__media--mobile">
        {{ s.image_mobile | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '100vw', widths: '600, 900, 1200', alt: s.image_mobile.alt | default: s.heading }}
      </div>
    {%- endif -%}
  {%- endif -%}

  <div class="container">
    <div class="hero__inner{% if s.show_widget and s.widget_position == 'side' %} hero__inner--split{% endif %}">
      <div class="hero__content{% if s.align == 'center' %} hero__content--center{% endif %}">
        {%- if s.eyebrow != blank -%}<p class="eyebrow reveal">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h1 class="reveal" style="--i: 1">{{ s.heading }}</h1>{%- endif -%}
        {%- if s.subheading != blank -%}<div class="hero__subtitle rte reveal" style="--i: 2">{{ s.subheading }}</div>{%- endif -%}
        <div class="btn-row reveal" style="--i: 3">
          {%- if s.button_label != blank -%}
            <a class="btn btn--large" href="{{ s.button_link | default: settings.booking_page.url | default: '#reservation' }}">{{ s.button_label }}{% render 'icon', name: 'arrow-right' %}</a>
          {%- endif -%}
          {%- if s.show_call and settings.company_phone != blank -%}
            <a class="btn btn--large btn--secondary" href="tel:{{ phone_href }}" aria-label="{{ 'accessibility.phone_link' | t: phone: settings.company_phone }}">{% render 'icon', name: 'phone' %}{{ settings.company_phone }}</a>
          {%- elsif s.button2_label != blank -%}
            <a class="btn btn--large btn--secondary" href="{{ s.button2_link }}">{{ s.button2_label }}</a>
          {%- endif -%}
        </div>
        {%- if section.blocks.size > 0 -%}
          <ul class="hero__trust reveal" style="--i: 4">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}{{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if s.show_widget -%}
        <div class="hero__widget reveal" style="--i: 2">
          <div class="tp-quick" data-tp-quick>
            {%- if s.widget_title != blank -%}<h2 class="tp-quick__title">{{ s.widget_title }}</h2>{%- endif -%}
            <noscript><p>{{ 'taxi.booking.nojs' | t }}</p></noscript>
            <form novalidate>
              <div class="tp-addresses">
                {% render 'tp-address-field', key: 'pickup', uid: uid, label: l_pickup, placeholder: p_pickup, locate: true %}
                {% render 'tp-address-field', key: 'dropoff', uid: uid, label: l_dropoff, placeholder: p_dropoff, locate: false %}
              </div>
              <div class="tp-quick__row">
                <div class="field">
                  <label class="field__label" for="{{ uid }}-date">{{ 'taxi.booking.date_label' | t }}</label>
                  <input class="input" type="date" id="{{ uid }}-date" name="date">
                </div>
                <div class="field">
                  <label class="field__label" for="{{ uid }}-time">{{ 'taxi.booking.time_label' | t }}</label>
                  <input class="input" type="time" id="{{ uid }}-time" name="time" step="300">
                </div>
                {% render 'tp-stepper', key: 'passengers', uid: uid, label: l_passengers, value: 1, min: 1, max: settings.booking_max_passengers %}
              </div>
              {%- assign quick_label = 'taxi.booking.quick_submit' | t -%}
              <button type="submit" class="btn btn--large btn--block">{{ s.widget_button | default: quick_label }}</button>
              <div class="tp-quick__result" data-tp-quick-result aria-live="polite" hidden></div>
            </form>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Héros",
  "tag": "div",
  "class": "section-hero",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Média" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "2400 × 1400 px conseillé." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image sur mobile (facultative)", "info": "Format portrait conseillé." },
    { "type": "video", "id": "video", "label": "Vidéo en boucle (facultative)", "info": "Remplace l'image sur ordinateur et mobile. Vidéo courte et légère, sans son." },
    { "type": "range", "id": "overlay", "label": "Assombrissement de l'image", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },
    { "type": "select", "id": "color_scheme", "label": "Couleurs sans image", "options": [ { "value": "default", "label": "Principal" }, { "value": "alt", "label": "Secondaire" }, { "value": "inverse", "label": "Contrasté" }, { "value": "accent", "label": "Accent" } ], "default": "inverse" },
    { "type": "header", "content": "Mise en page" },
    {
      "type": "select", "id": "height", "label": "Hauteur",
      "options": [ { "value": "small", "label": "Petite" }, { "value": "medium", "label": "Moyenne" }, { "value": "large", "label": "Grande" }, { "value": "full", "label": "Plein écran" }, { "value": "auto", "label": "Selon le contenu" } ],
      "default": "large"
    },
    { "type": "select", "id": "align", "label": "Alignement du texte", "options": [ { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centré" } ], "default": "left" },
    { "type": "select", "id": "align_y", "label": "Position verticale", "options": [ { "value": "flex-start", "label": "Haut" }, { "value": "center", "label": "Milieu" }, { "value": "flex-end", "label": "Bas" } ], "default": "center" },
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Taxi & chauffeur privé · 24 h/24" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Votre taxi, réservé en un instant." },
    { "type": "richtext", "id": "subheading", "label": "Sous-titre", "default": "<p>Prix affiché avant de réserver, chauffeurs professionnels, transferts aéroport et longues distances.</p>" },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "Réserver un taxi" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton principal", "info": "Vide : page de réservation des réglages du thème." },
    { "type": "checkbox", "id": "show_call", "label": "Second bouton : appeler (téléphone des réglages)", "default": true },
    { "type": "text", "id": "button2_label", "label": "Second bouton (si l'appel est désactivé)" },
    { "type": "url", "id": "button2_link", "label": "Lien du second bouton" },
    { "type": "header", "content": "Calculateur rapide" },
    { "type": "checkbox", "id": "show_widget", "label": "Afficher le calculateur de prix", "default": true },
    { "type": "select", "id": "widget_position", "label": "Position", "options": [ { "value": "side", "label": "À côté du texte" }, { "value": "below", "label": "Sous le texte" } ], "default": "side" },
    { "type": "text", "id": "widget_title", "label": "Titre du calculateur", "default": "Estimez votre course" },
    { "type": "text", "id": "widget_button", "label": "Texte du bouton", "default": "Voir les prix" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Argument",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône",
          "options": [
            { "value": "check", "label": "Coche" }, { "value": "star", "label": "Étoile" }, { "value": "shield", "label": "Bouclier" },
            { "value": "clock", "label": "Horloge" }, { "value": "plane", "label": "Avion" }, { "value": "euro", "label": "Prix" },
            { "value": "card", "label": "Carte bancaire" }, { "value": "award", "label": "Récompense" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "text", "label": "Texte", "default": "Prix connu à l'avance" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Héros avec calculateur",
      "blocks": [
        { "type": "trust", "settings": { "icon": "euro", "text": "Prix connu à l'avance" } },
        { "type": "trust", "settings": { "icon": "clock", "text": "Disponible 24 h/24" } },
        { "type": "trust", "settings": { "icon": "plane", "text": "Suivi des vols" } }
      ]
    }
  ]
}
{% endschema %}
