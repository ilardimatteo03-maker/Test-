{%- assign s = section.settings -%}
{%- assign default_title = 'pages.password_title' | t -%}
<section class="section scheme-inverse" style="--pad-top: 120px; --pad-bottom: 120px; min-height: 100vh; display: grid; place-items: center;">
  <div class="container container--narrow text-center">
    <p class="logo-text" style="font-size: 2rem">{{ settings.company_name | default: shop.name }}</p>
    <h1 class="h2" style="margin-top: 2rem">{{ s.heading | default: default_title }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead" style="margin-inline: auto">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'search-form' -%}
      {%- if form.errors -%}<p class="form-status form-status--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="visually-hidden" for="Password">{{ 'pages.password_label' | t }}</label>
      <input class="input" id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'pages.password_label' | t }}">
      <button class="btn" type="submit">{{ 'pages.password_submit' | t }}</button>
    {%- endform -%}
    <p class="text-muted" style="margin-top: 3rem; font-size: .85rem">{{ 'pages.password_owner' | t }} <a href="/admin">{{ 'pages.password_login' | t }}</a></p>
  </div>
</section>
{% schema %}
{
  "name": "Mot de passe",
  "tag": "div",
  "class": "section-main-password",
  "settings": [ { "type": "text", "id": "heading", "label": "Titre" } ]
}
{% endschema %}
