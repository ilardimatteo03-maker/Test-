{%- comment -%}
  Configuration Taxi Pro — Options supplémentaires (étape « Options »).
  Types : montant fixe, montant à l'unité (quantité), pourcentage de la course.
{%- endcomment -%}
<script type="application/json" data-tp-config="options">
[
{%- for block in section.blocks -%}
  {
    "id": {{ block.settings.code | default: block.settings.name | handleize | json }},
    "enabled": {{ block.settings.enabled | json }},
    "name": {{ block.settings.name | json }},
    "description": {{ block.settings.description | json }},
    "icon": {{ block.settings.icon | json }},
    "type": {{ block.settings.type | json }},
    "price": {{ block.settings.price | json }},
    "maxQty": {{ block.settings.max_qty | json }},
    "services": {{ block.settings.services | json }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
</script>
{%- if request.design_mode -%}
  <div class="tp-config-panel" {{ section.shopify_attributes }}>
    <strong>Configuration Taxi Pro · Options</strong> : {{ section.blocks.size }} option(s).
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Options (tarifs)",
  "tag": "div",
  "class": "tp-config",
  "max_blocks": 30,
  "enabled_on": { "groups": ["custom.taxi-config"] },
  "settings": [
    { "type": "paragraph", "content": "Options proposées à l'étape « Options ». L'aller-retour se choisit à l'étape « Trajet » et la mise à disposition est une prestation (mode « à l'heure »)." }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Option",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Proposer cette option", "default": true },
        { "type": "text", "id": "name", "label": "Nom", "default": "Siège bébé" },
        { "type": "text", "id": "code", "label": "Code", "info": "Identifiant court sans espace (ex. siege-bebe)." },
        { "type": "text", "id": "description", "label": "Description courte" },
        {
          "type": "select", "id": "icon", "label": "Icône",
          "options": [
            { "value": "baby", "label": "Siège bébé / enfant" }, { "value": "booster", "label": "Rehausseur" },
            { "value": "luggage", "label": "Bagage" }, { "value": "sign", "label": "Pancarte" },
            { "value": "briefcase", "label": "Professionnel" }, { "value": "water", "label": "Boissons" },
            { "value": "wifi", "label": "Wi-Fi" }, { "value": "dog", "label": "Animal" },
            { "value": "wheelchair", "label": "Fauteuil roulant" }, { "value": "sparkle", "label": "Premium" },
            { "value": "clock", "label": "Temps" }, { "value": "plus", "label": "Autre" }
          ],
          "default": "baby"
        },
        {
          "type": "select", "id": "type", "label": "Prix",
          "options": [
            { "value": "fixed", "label": "Montant fixe (case à cocher)" },
            { "value": "per_unit", "label": "Montant à l'unité (quantité)" },
            { "value": "percent", "label": "Pourcentage du prix de la course" }
          ],
          "default": "fixed"
        },
        { "type": "text", "id": "price", "label": "Montant ou pourcentage", "default": "10", "info": "0 = option gratuite (affichée « Inclus »)." },
        { "type": "number", "id": "max_qty", "label": "Quantité maximale (à l'unité)", "default": 2 },
        { "type": "text", "id": "services", "label": "Réservée aux prestations", "info": "Codes de prestations séparés par des virgules (ex. aeroport). Vide = toutes." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Options (tarifs)",
      "blocks": [
        { "type": "option", "settings": { "name": "Siège bébé", "code": "siege-bebe", "icon": "baby" } }
      ]
    }
  ]
}
{% endschema %}
