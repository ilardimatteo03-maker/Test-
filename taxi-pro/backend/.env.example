# ---------------------------------------------------------------------------
# TAXI PRO — service de réservation : exemple de configuration (une seule entreprise)
# Copiez ce fichier en .env (ou saisissez ces variables chez votre hébergeur).
# Pour plusieurs entreprises, utilisez TENANTS_FILE=tenants.json (voir tenants.example.json).
# ---------------------------------------------------------------------------
PORT=8787
PUBLIC_URL=https://reservations.votre-domaine.be     # adresse publique de ce service (liens du tableau de bord)
DATA_DIR=./data                                       # dossier des réservations (à sauvegarder)
TRUST_PROXY=true                                      # derrière un proxy (Render, Railway, Nginx…)

# Boutique
TENANT_ID=taxi-exemple
SHOP_DOMAIN=taxi-exemple.myshopify.com
STOREFRONT_URL=https://www.taxi-exemple.be
ALLOWED_ORIGINS=https://www.taxi-exemple.be,https://taxi-exemple.myshopify.com
STOREFRONT_PASSWORD=                                  # si la boutique est protégée par mot de passe
PREVIEW_THEME_ID=                                     # pour tester un thème non publié (identifiant numérique)

# Itinéraires (clé secrète, restreinte à l'adresse IP du serveur)
ROUTING_PROVIDER=google                               # google | mapbox | osrm | estimate
ROUTING_API_KEY=
OSRM_URL=                                             # serveur OSRM auto-hébergé (si ROUTING_PROVIDER=osrm)
ROUTING_ESTIMATE_FALLBACK=false

# E-mails
EMAIL_PROVIDER=resend                                 # resend | postmark | sendgrid | brevo | console | file
EMAIL_API_KEY=
EMAIL_FROM=Taxi Exemple <reservations@taxi-exemple.be>
ADMIN_EMAIL=planning@taxi-exemple.be
EMAIL_REPLY_TO=contact@taxi-exemple.be

# Paiement en ligne (facultatif)
PAYMENT_PROVIDER=shopify                              # shopify | stripe | (vide = pas de paiement en ligne)
SHOPIFY_ADMIN_TOKEN=                                  # application personnalisée : write_draft_orders, read_orders
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=                               # clé de signature des webhooks (Paramètres › Notifications › Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Administration et intégrations
ADMIN_TOKEN=                                          # long jeton aléatoire (ex. : openssl rand -base64 32)
OUTBOUND_WEBHOOK_URL=                                 # Zapier, Make, logiciel de dispatch… (facultatif)
OUTBOUND_WEBHOOK_SECRET=
REMINDER_HOURS=24
REMINDER_INTERVAL_MINUTES=5
CONFIG_CACHE_SECONDS=60
