# Fidélo by ASM — variables d'environnement
# L'application fonctionne SANS ces variables (mode démo avec localStorage).
# Renseignez-les pour passer en production (Supabase + Stripe).

# --- Supabase (base de données + Auth) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role : SERVEUR UNIQUEMENT (webhook Stripe). Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (abonnement mensuel) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ID du prix récurrent « Fidélo Pro » (ex : price_123...)
STRIPE_PRICE_PRO_MONTHLY=
# Optionnel (front)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- App ---
# URL publique de l'app (utilisée pour les redirections Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Notifications email (Resend) — optionnel ---
# Email automatique au client quand il gagne sa récompense.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Fidélo <notifications@votredomaine.fr>"

# --- Cartes Wallet (Apple / Google) — optionnel ---
# Affiche les boutons « Ajouter au Wallet » sur la carte client.
NEXT_PUBLIC_WALLET_ENABLED=false

# Apple Wallet (compte Apple Developer requis). PEM en base64 ou brut.
APPLE_PASS_TYPE_ID=            # ex : pass.com.asm.fidelo
APPLE_TEAM_ID=
APPLE_PASS_CERT=              # certificat Pass Type ID (PEM)
APPLE_PASS_KEY=              # clé privée (PEM)
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=             # Apple WWDR G4 (PEM)

# Google Wallet (compte de service Google Cloud). Clé privée PEM en base64/brut.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=       # ex : 3388000000022000000.fidelo_loyalty
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY=
