# Fidélo — variables d'environnement
# L'application fonctionne SANS ces variables (mode démo avec données mockées).
# Renseignez-les uniquement quand vous branchez de vrais services.

# --- Supabase (base de données + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe (abonnements) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
