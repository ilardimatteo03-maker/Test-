# Fidélo by ASM — variables d'environnement
# L'application fonctionne SANS ces variables (mode démo avec localStorage).
# Renseignez-les pour passer en production (Supabase + Stripe).

# --- Supabase (base de données + Auth) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role : SERVEUR UNIQUEMENT (webhook Stripe). Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (abonnement mensuel) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ID du prix récurrent « Fidélo Pro » (ex : price_123...)
STRIPE_PRICE_PRO_MONTHLY=
# Optionnel (front)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- App ---
# URL publique de l'app (utilisée pour les redirections Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
