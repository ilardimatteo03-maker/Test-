# Cle API Anthropic (Claude), utilisee par scripts/generate-article.mjs
# Creer une cle sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# URL publique du site une fois deploye (utilisee pour le sitemap, les
# canonical, l'Open Graph...). Sans slash final.
NEXT_PUBLIC_SITE_URL=https://votredomaine.fr

# Tag d'affilie Amazon (Programme Partenaires Amazon EU), format "xxxx-21"
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=votretag-21
